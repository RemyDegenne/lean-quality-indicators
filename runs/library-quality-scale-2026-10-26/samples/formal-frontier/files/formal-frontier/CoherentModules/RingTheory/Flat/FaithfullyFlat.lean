module

public import Mathlib.RingTheory.Flat.FaithfullyFlat.Basic
public import Mathlib.RingTheory.Finiteness.Ideal

/-!
# Criteria for faithful flatness

A flat module surjecting onto a faithfully flat module is faithfully flat.
For a unital algebra, faithful flatness can be tested using only finitely
generated proper ideals, together with flatness. The algebra need not be
commutative. The coefficient ring and module carriers may lie in independent
universes.

## Proof approach

Mapping an equality `I • ⊤ = ⊤` along the surjection gives the same equality
in the target. The target's faithful flatness forces `I = ⊤`; combining this
with the source's flatness proves faithful flatness of the source.

For the algebra criterion, a finite linear combination witnessing
`1 ∈ I • ⊤` uses only finitely many coefficients from `I`. The ideal `J`
generated by those coefficients is finitely generated and contained in `I`.
Right multiplication is linear, so `1 ∈ J • ⊤` implies `a ∈ J • ⊤` for
every algebra element `a`. This argument uses the identity but not
commutativity of the algebra.

## References

The proofs use Mathlib's ideal-smul criteria for faithful flatness,
`Submodule.map_smul''`, `Submodule.map_top`, `LinearMap.range_eq_top`,
`Submodule.mem_ideal_smul_span_iff_exists_sum`, `LinearMap.mulRight` and
`Submodule.smul_top_le_comap_smul_top`.
-/

@[expose] public section

universe u v w

namespace Submodule

private theorem one_mem_ideal_smul_top_iff
    {R : Type u} {A : Type v} [Semiring R] [Semiring A]
    [Module R A] [IsScalarTower R A A] (I : Ideal R) :
    (1 : A) ∈ I • (⊤ : Submodule R A) ↔ I • (⊤ : Submodule R A) = ⊤ := by
  constructor
  · intro h1
    apply top_unique
    intro a _
    simpa only [Submodule.mem_comap, LinearMap.mulRight_apply, one_mul] using
      (Submodule.smul_top_le_comap_smul_top I (LinearMap.mulRight R a) h1)
  · intro h
    rw [h]
    exact Submodule.mem_top

end Submodule

namespace Module.FaithfullyFlat

/-- A flat source module is faithfully flat if it admits a surjective linear map
onto a faithfully flat target module over the same commutative ring. -/
theorem of_surjective
    {R : Type u} {M : Type v} {N : Type w}
    [CommRing R] [AddCommGroup M] [AddCommGroup N] [Module R M] [Module R N]
    [Module.Flat R M] [Module.FaithfullyFlat R N]
    (f : M →ₗ[R] N) (hf : Function.Surjective f) : Module.FaithfullyFlat R M := by
  apply (Module.FaithfullyFlat.iff_flat_and_ideal_smul_eq_top R M).mpr
  refine ⟨inferInstance, ?_⟩
  intro I hI
  apply ((Module.FaithfullyFlat.iff_flat_and_ideal_smul_eq_top R N).mp inferInstance).2 I
  simpa only [Submodule.map_smul'', Submodule.map_top,
    LinearMap.range_eq_top.mpr hf] using congrArg (Submodule.map f) hI

/-- A unital algebra is faithfully flat precisely when it is flat and every
finitely generated proper ideal acts with proper image. The algebra need not
be commutative: an ideal acting with full image has a finite subideal whose
image contains the algebra's identity. This criterion is not asserted for
arbitrary modules without an algebra structure. -/
theorem algebra_iff_flat_and_fg_proper_ideal
    (R : Type u) (A : Type v) [CommRing R] [Ring A] [Algebra R A] :
    Module.FaithfullyFlat R A ↔ Module.Flat R A ∧
      ∀ I : Ideal R, I.FG → I ≠ ⊤ → I • (⊤ : Submodule R A) ≠ ⊤ := by
  constructor
  · intro h
    obtain ⟨hflat, hproper⟩ := (iff_flat_and_proper_ideal R A).mp h
    exact ⟨hflat, fun I _ hI => hproper I hI⟩
  · rintro ⟨hflat, hproper⟩
    apply (iff_flat_and_proper_ideal R A).mpr
    refine ⟨hflat, ?_⟩
    intro I hI hIA
    have h1 : (1 : A) ∈ I • (⊤ : Submodule R A) := by
      rw [hIA]
      exact Submodule.mem_top
    obtain ⟨c, hc, hc1⟩ :=
      (Submodule.mem_ideal_smul_span_iff_exists_sum I (id : A → A) 1).mp
        (by simpa only [Set.range_id, Submodule.span_univ] using h1)
    classical
    let J : Ideal R := Ideal.span (↑(c.support.image c) : Set R)
    have hJfg : J.FG := ⟨c.support.image c, rfl⟩
    have hJI : J ≤ I := by
      apply Ideal.span_le.mpr
      intro r hr
      obtain ⟨a, _, rfl⟩ := Finset.mem_image.mp hr
      exact hc a
    have hJ : J ≠ ⊤ := fun hJtop => hI (top_unique (hJtop ▸ hJI))
    apply hproper J hJfg hJ
    apply (Submodule.one_mem_ideal_smul_top_iff J).mp
    rw [← hc1]
    exact Submodule.sum_mem _ fun a ha =>
      Submodule.smul_mem_smul
        (Ideal.subset_span (Finset.mem_image.mpr ⟨a, ha, rfl⟩)) Submodule.mem_top

end Module.FaithfullyFlat
