module

public import Mathlib.Algebra.Ring.Defs

import Mathlib.RingTheory.Localization.AsSubring
public import MultivariatePolynomials.FractionRingAlgebraicIndependence
public import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis

/-!
# Transcendence bases for renamed polynomial fraction rings

Let `R` be a commutative domain and `ρ : τ → σ` an injective variable map.
For arbitrary fraction rings `L` of `MvPolynomial τ R` and `K` of
`MvPolynomial σ R`, the localized variables outside the range of `ρ` form a
transcendence basis of `K` over `L`. The `L`-algebra structure on `K` must be
the canonical fraction-ring map induced by `MvPolynomial.rename ρ`.

In particular, `K` is algebraic over the `L`-subalgebra generated by those
complementary variables. No finite-variable or `Field` instances are required;
the coefficient, variable and fraction-ring types have independent universes.

## References

The proofs use Mathlib's `IsLocalization.isAlgebraic`,
`Algebra.IsAlgebraic.extendScalars`, and
`AlgebraicIndependent.isTranscendenceBasis_iff_isAlgebraic`, together with
algebraic independence over the source fraction ring.
-/

@[expose] public section

universe uR uτ uσ uL uK

namespace MvPolynomial

/-- A target fraction ring is algebraic over the source-fraction-ring adjoin of
variables outside an injective renaming. The full canonical fraction-map equality
fixes the coefficient action on the target. -/
theorem isAlgebraic_adjoin_fractionRing_map_rename_compl
    {R : Type uR} [CommRing R] [IsDomain R]
    {τ : Type uτ} {σ : Type uσ}
    {L : Type uL} [CommRing L] [Algebra (MvPolynomial τ R) L]
    [IsFractionRing (MvPolynomial τ R) L]
    {K : Type uK} [CommRing K] [Algebra (MvPolynomial σ R) K]
    [IsFractionRing (MvPolynomial σ R) K] [Algebra L K]
    (ρ : τ → σ) (hρ : Function.Injective ρ)
    (hmap : algebraMap L K = IsFractionRing.map
      (A := MvPolynomial τ R) (B := MvPolynomial σ R) (K := L) (L := K)
      (j := (rename (R := R) ρ).toRingHom) (rename_injective ρ hρ)) :
    Algebra.IsAlgebraic
      (Algebra.adjoin L (Set.range (fun i : {i : σ // i ∉ Set.range ρ} =>
        algebraMap (MvPolynomial σ R) K (X i.1)))) K := by
  classical
  let A := Algebra.adjoin L (Set.range (fun i : {i : σ // i ∉ Set.range ρ} =>
    algebraMap (MvPolynomial σ R) K (X i.1)))
  have hrename (p : MvPolynomial τ R) :
      algebraMap L K (algebraMap (MvPolynomial τ R) L p) =
        algebraMap (MvPolynomial σ R) K (rename ρ p) := by
    rw [hmap]
    simp only [IsFractionRing.map, IsLocalization.map_eq,
      AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom]
  have hC (r : R) : algebraMap (MvPolynomial σ R) K (C r) ∈ A := by
    simpa only [hrename, rename_C] using
      (A.algebraMap_mem (algebraMap (MvPolynomial τ R) L (C r)))
  have hX (i : σ) : algebraMap (MvPolynomial σ R) K (X i) ∈ A := by
    by_cases hi : i ∈ Set.range ρ
    · obtain ⟨j, rfl⟩ := hi
      simpa only [hrename, rename_X] using
        (A.algebraMap_mem (algebraMap (MvPolynomial τ R) L (X j)))
    · exact Algebra.subset_adjoin ⟨⟨i, hi⟩, rfl⟩
  have hQ (p : MvPolynomial σ R) : algebraMap (MvPolynomial σ R) K p ∈ A := by
    induction p using MvPolynomial.induction_on with
    | C r => exact hC r
    | add p q hp hq => simpa only [map_add] using A.add_mem hp hq
    | mul_X p i hp => simpa only [map_mul] using A.mul_mem hp (hX i)
  let ψ : MvPolynomial σ R →+* A :=
    (algebraMap (MvPolynomial σ R) K).codRestrict A.toSubring hQ
  letI : Algebra (MvPolynomial σ R) A := ψ.toAlgebra
  letI : IsScalarTower (MvPolynomial σ R) A K :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hψ : Function.Injective (algebraMap (MvPolynomial σ R) A) := by
    intro p q hpq
    apply IsFractionRing.injective (MvPolynomial σ R) K
    exact congrArg (fun a : A => (a : K)) hpq
  letI : Algebra.IsAlgebraic (MvPolynomial σ R) K :=
    IsLocalization.isAlgebraic K (nonZeroDivisors (MvPolynomial σ R))
  exact Algebra.IsAlgebraic.extendScalars (R := MvPolynomial σ R) (S := A) (A := K) hψ

/-- The localized variables outside an injective renaming form a transcendence
basis over the source fraction ring, for the full canonical fraction-map action. -/
theorem isTranscendenceBasis_fractionRing_map_rename_compl
    {R : Type uR} [CommRing R] [IsDomain R]
    {τ : Type uτ} {σ : Type uσ}
    {L : Type uL} [CommRing L] [Algebra (MvPolynomial τ R) L]
    [IsFractionRing (MvPolynomial τ R) L]
    {K : Type uK} [CommRing K] [Algebra (MvPolynomial σ R) K]
    [IsFractionRing (MvPolynomial σ R) K] [Algebra L K]
    (ρ : τ → σ) (hρ : Function.Injective ρ)
    (hmap : algebraMap L K = IsFractionRing.map
      (A := MvPolynomial τ R) (B := MvPolynomial σ R) (K := L) (L := K)
      (j := (rename (R := R) ρ).toRingHom) (rename_injective ρ hρ)) :
    IsTranscendenceBasis L (fun i : {i : σ // i ∉ Set.range ρ} =>
      algebraMap (MvPolynomial σ R) K (X i.1)) := by
  letI : IsDomain L := IsFractionRing.isDomain (MvPolynomial τ R)
  have hi := algebraicIndependent_fractionRing_map_rename_compl ρ hρ hmap
  exact hi.isTranscendenceBasis_iff_isAlgebraic.mpr
    (isAlgebraic_adjoin_fractionRing_map_rename_compl ρ hρ hmap)

/-- Localizing the source-fraction-ring algebra generated by variables outside an
injective renaming at its nonzero elements gives the target fraction ring, through
the subalgebra inclusion and the full canonical fraction-map coefficient action. -/
theorem isFractionRing_adjoin_fractionRing_map_rename_compl
    {R : Type uR} [CommRing R] [IsDomain R]
    {τ : Type uτ} {σ : Type uσ}
    {L : Type uL} [CommRing L] [Algebra (MvPolynomial τ R) L]
    [IsFractionRing (MvPolynomial τ R) L]
    {K : Type uK} [CommRing K] [Algebra (MvPolynomial σ R) K]
    [IsFractionRing (MvPolynomial σ R) K] [Algebra L K]
    (ρ : τ → σ) (hρ : Function.Injective ρ)
    (hmap : algebraMap L K = IsFractionRing.map
      (A := MvPolynomial τ R) (B := MvPolynomial σ R) (K := L) (L := K)
      (j := (rename (R := R) ρ).toRingHom) (rename_injective ρ hρ)) :
    IsFractionRing
      (Algebra.adjoin L (Set.range (fun i : {i : σ // i ∉ Set.range ρ} =>
        algebraMap (MvPolynomial σ R) K (X i.1)))) K := by
  classical
  letI : Field K := IsFractionRing.toField (MvPolynomial σ R)
  let A := Algebra.adjoin L (Set.range (fun i : {i : σ // i ∉ Set.range ρ} =>
    algebraMap (MvPolynomial σ R) K (X i.1)))
  have hrename (p : MvPolynomial τ R) :
      algebraMap L K (algebraMap (MvPolynomial τ R) L p) =
        algebraMap (MvPolynomial σ R) K (rename ρ p) := by
    rw [hmap]
    simp only [IsFractionRing.map, IsLocalization.map_eq,
      AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom]
  have hC (r : R) : algebraMap (MvPolynomial σ R) K (C r) ∈ A := by
    simpa only [hrename, rename_C] using
      (A.algebraMap_mem (algebraMap (MvPolynomial τ R) L (C r)))
  have hX (i : σ) : algebraMap (MvPolynomial σ R) K (X i) ∈ A := by
    by_cases hi : i ∈ Set.range ρ
    · obtain ⟨j, rfl⟩ := hi
      simpa only [hrename, rename_X] using
        (A.algebraMap_mem (algebraMap (MvPolynomial τ R) L (X j)))
    · exact Algebra.subset_adjoin ⟨⟨i, hi⟩, rfl⟩
  have hQ (p : MvPolynomial σ R) : algebraMap (MvPolynomial σ R) K p ∈ A := by
    rw [← eval₂_eta p, eval₂_comp_left]
    exact eval₂_mem (fun _ _ => hC _) hX
  -- The same subsemiring contains the original polynomial coefficient ring.
  let T : Subalgebra (MvPolynomial σ R) K :=
    { A.toSubsemiring with algebraMap_mem' := hQ }
  -- Its inclusion into K is unchanged by this choice of coefficient ring.
  change IsFractionRing T K
  infer_instance

end MvPolynomial
