module

public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.RingTheory.Ideal.Cotangent
public import Mathlib.LinearAlgebra.Basis.Basic

/-!
# Cotangent module of the polynomial augmentation ideal

The classes of the variables form a basis of the cotangent module of
`MvPolynomial.idealOfVars` over the coefficient ring. The coordinates of a
class are the linear coefficients of any representative in the ideal, so
terms of degree at least two do not contribute.

The variable type may be empty or infinite, and the coefficient ring may
have zero divisors. Scalars use the inherited polynomial-algebra action.

## References

* Mathlib, `Mathlib.RingTheory.MvPolynomial.Ideal` (the variable ideal),
  `Mathlib.RingTheory.Ideal.Cotangent` (the ideal modulo its square and its
  inherited scalar actions), and `Mathlib.LinearAlgebra.Basis.Basic`
  (bases of prescribed spanning, linearly independent families).
-/

@[expose] public section

namespace MvPolynomial

universe u v

variable (σ : Type u) (R : Type v) [CommRing R]

private noncomputable def idealOfVarsCotangentLinearCoeff (i : σ) :
    (idealOfVars σ R).Cotangent →ₗ[R] R :=
  Ideal.Cotangent.lift
    ((lcoeff R (Finsupp.single i 1)).comp
      ((idealOfVars σ R).subtype.restrictScalars R))
    (by
      intro x y
      change ((x : MvPolynomial σ R) * (y : MvPolynomial σ R)).coeff
        (Finsupp.single i 1) = 0
      exact (mem_pow_idealOfVars_iff' 2 _).mp
        (by simpa only [pow_two] using Ideal.mul_mem_mul x.property y.property)
        _ (by simp))

@[simp] private theorem idealOfVarsCotangentLinearCoeff_toCotangent
    (x : idealOfVars σ R) (i : σ) :
    idealOfVarsCotangentLinearCoeff σ R i ((idealOfVars σ R).toCotangent x) =
      (x : MvPolynomial σ R).coeff (Finsupp.single i 1) := rfl

@[simp] private theorem idealOfVarsCotangentLinearCoeff_X (i j : σ) :
    idealOfVarsCotangentLinearCoeff σ R i
      ((idealOfVars σ R).toCotangent
        ⟨X j, Ideal.subset_span (Set.mem_range_self j)⟩) =
      Finsupp.single j (1 : R) i := by
  classical
  rw [idealOfVarsCotangentLinearCoeff_toCotangent]
  simp [MvPolynomial.coeff_X, Finsupp.single_apply,
    Finsupp.single_left_inj (by decide : (1 : ℕ) ≠ 0), eq_comm]

private theorem linearIndependent_idealOfVars_toCotangent_X :
    LinearIndependent R (fun i : σ => (idealOfVars σ R).toCotangent
      ⟨X i, Ideal.subset_span (Set.mem_range_self i)⟩) := by
  classical
  refine linearIndependent_iff'.mpr ?_
  intro s a h i hi
  simpa [Finsupp.single_apply, hi] using
    congrArg (idealOfVarsCotangentLinearCoeff σ R i) h

private theorem sub_C_constantCoeff_mem_idealOfVars (p : MvPolynomial σ R) :
    p - C (constantCoeff p) ∈ idealOfVars σ R := by
  rw [← pow_one (idealOfVars σ R), mem_pow_idealOfVars_iff']
  intro d hd
  have hd0 : d = 0 := (Finsupp.degree_eq_zero_iff d).mp (Nat.lt_one_iff.mp hd)
  subst d
  change constantCoeff (p - C (constantCoeff p)) = 0
  simp

private theorem idealOfVarsCotangent_smul_constantCoeff
    (p : MvPolynomial σ R) (m : (idealOfVars σ R).Cotangent) :
    p • m = constantCoeff p • m := by
  have hzero : (p - C (constantCoeff p)) • m = 0 :=
    Ideal.Cotangent.smul_eq_zero_of_mem
      (sub_C_constantCoeff_mem_idealOfVars σ R p) m
  have hconstant : (C (constantCoeff p) : MvPolynomial σ R) • m =
      constantCoeff p • m :=
    IsScalarTower.algebraMap_smul (MvPolynomial σ R) (constantCoeff p) m
  rw [sub_smul, hconstant, sub_eq_zero] at hzero
  exact hzero

private theorem idealOfVarsCotangent_span :
    ⊤ ≤ Submodule.span R (Set.range (fun i : σ =>
      (idealOfVars σ R).toCotangent
        ⟨X i, Ideal.subset_span (Set.mem_range_self i)⟩)) := by
  let S : Submodule R (idealOfVars σ R).Cotangent :=
    Submodule.span R (Set.range (fun i : σ =>
      (idealOfVars σ R).toCotangent
        ⟨X i, Ideal.subset_span (Set.mem_range_self i)⟩))
  intro z hz
  clear hz
  obtain ⟨x, rfl⟩ := (idealOfVars σ R).toCotangent_surjective z
  change (idealOfVars σ R).toCotangent x ∈ S
  rcases x with ⟨p, hp⟩
  induction hp using Submodule.span_induction with
  | mem p hp =>
      rcases hp with ⟨i, rfl⟩
      exact Submodule.subset_span (Set.mem_range_self i)
  | zero =>
      change (idealOfVars σ R).toCotangent 0 ∈ S
      simpa only [map_zero] using S.zero_mem
  | add p q hp hq ihp ihq =>
      change (idealOfVars σ R).toCotangent
        ((⟨p, hp⟩ : idealOfVars σ R) + ⟨q, hq⟩) ∈ S
      rw [map_add]
      exact S.add_mem ihp ihq
  | smul p q hq ih =>
      change (idealOfVars σ R).toCotangent
        (p • (⟨q, hq⟩ : idealOfVars σ R)) ∈ S
      rw [map_smul, idealOfVarsCotangent_smul_constantCoeff]
      exact S.smul_mem (constantCoeff p) ih

/-- The classes of the variables form a coefficient-ring basis of the cotangent
module of the ideal generated by all variables. The scalar action is inherited
from the polynomial algebra: `r • [p] = [C r * p]`. No finiteness or nonemptiness
assumption on the variable type is needed. -/
noncomputable def idealOfVarsCotangentBasis :
    Module.Basis σ R (idealOfVars σ R).Cotangent :=
  Module.Basis.mk
    (v := fun i : σ => (idealOfVars σ R).toCotangent
      ⟨X i, Ideal.subset_span (Set.mem_range_self i)⟩)
    (by exact linearIndependent_idealOfVars_toCotangent_X σ R)
    (by exact idealOfVarsCotangent_span σ R)

/-- The basis vector indexed by `i` is the cotangent class of `X i`. -/
@[simp]
theorem idealOfVarsCotangentBasis_apply (i : σ) :
    idealOfVarsCotangentBasis σ R i =
      (idealOfVars σ R).toCotangent
        ⟨X i, Ideal.subset_span (Set.mem_range_self i)⟩ := by
  exact Module.Basis.mk_apply _ _ i

/-- The coordinates of a variable class are the corresponding unit vector. -/
@[simp]
theorem idealOfVarsCotangentBasis_repr_X (i : σ) :
    (idealOfVarsCotangentBasis σ R).repr
      ((idealOfVars σ R).toCotangent
        ⟨X i, Ideal.subset_span (Set.mem_range_self i)⟩) =
      Finsupp.single i 1 := by
  rw [← idealOfVarsCotangentBasis_apply σ R i]
  exact (idealOfVarsCotangentBasis σ R).repr_self i

/-- The `i`th coordinate of a cotangent class is the coefficient of `X i` in
its polynomial representative. In particular, terms of degree at least two
do not contribute to these coordinates. -/
@[simp]
theorem idealOfVarsCotangentBasis_repr_toCotangent
    (x : idealOfVars σ R) (i : σ) :
    (idealOfVarsCotangentBasis σ R).repr ((idealOfVars σ R).toCotangent x) i =
      (x : MvPolynomial σ R).coeff (Finsupp.single i 1) := by
  have hcoord : (idealOfVarsCotangentBasis σ R).coord i =
      idealOfVarsCotangentLinearCoeff σ R i := by
    apply (idealOfVarsCotangentBasis σ R).ext
    intro j
    simp only [Module.Basis.coord_apply, idealOfVarsCotangentBasis_apply,
      idealOfVarsCotangentBasis_repr_X, idealOfVarsCotangentLinearCoeff_X]
  change (idealOfVarsCotangentBasis σ R).coord i
    ((idealOfVars σ R).toCotangent x) = _
  rw [hcoord, idealOfVarsCotangentLinearCoeff_toCotangent]

end MvPolynomial
