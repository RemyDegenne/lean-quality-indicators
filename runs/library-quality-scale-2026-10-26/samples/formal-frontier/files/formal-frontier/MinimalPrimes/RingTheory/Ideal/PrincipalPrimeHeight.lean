module

public import Mathlib.RingTheory.Ideal.Height
public import Mathlib.RingTheory.Ideal.Maximal
public import Mathlib.RingTheory.UniqueFactorizationDomain.Multiplicity

/-!
# Height of a principal prime ideal

In a commutative ring with well-founded strict divisibility, the ideal generated by a prime
element has height at most one. If the generator is a non-zero-divisor, its height is exactly
one. In particular, a prime element generates an ideal of height one in a domain with
well-founded strict divisibility. No Noetherian hypothesis is required.

Here `WfDvdMonoid` means well-foundedness of `DvdNotUnit`. In domains this is equivalent to
ACCP for principal ideals. It is not merely the assertion that every nonzero nonunit has an
irreducible factorization. The upper bound requires a prime element, not just an irreducible
one, and does not give a height bound for arbitrary principal ideals.

The proof uses Mathlib's maximal-power factorization. If a nonzero prime ideal lies below
`span {p}`, factor a nonzero member as `p ^ n * b` with `p ∤ b`. The residual factor lies outside
`span {p}`, hence outside the smaller prime ideal. Primeness then forces `p` into that ideal.
Thus every prime ideal strictly below `span {p}` is the zero ideal, which has height zero in a
nontrivial commutative ring. Nontriviality follows from `Prime.ne_zero` within the proof.
The height here measures chains of prime ideals, not chains in the full lattice of ideals.

## References

The factorization step is Mathlib's `WfDvdMonoid.max_power_factor'`. The height argument uses
`Ideal.height_le_iff` and `Ideal.height_bot`; the equality uses
`Ideal.one_le_height_span_singleton_of_mem_nonZeroDivisors`. Primeness is supplied by
`Ideal.isPrime_span_singleton_of_prime` and `Ideal.IsPrime.mem_of_pow_mem`.
-/

@[expose] public section

universe u

namespace Ideal

/-- A prime element in a commutative ring with well-founded `DvdNotUnit` generates an ideal of
height at most one. No domain or Noetherian hypothesis is needed. The proof uses Mathlib's
`WfDvdMonoid.max_power_factor'` and its prime-ideal height criterion. -/
theorem height_span_singleton_le_one_of_prime
    {R : Type u} [CommRing R] [WfDvdMonoid R] {p : R} (hp : Prime p) :
    (span {p}).height ≤ 1 := by
  let : Nontrivial R := nontrivial_of_ne p 0 hp.ne_zero
  let : (span {p}).IsPrime := isPrime_span_singleton_of_prime hp
  refine (height_le_iff (n := 1)).mpr ?_
  intro Q hQ hQp
  have hQbot : Q = ⊥ := by
    by_contra hQbot
    obtain ⟨a, haQ, ha0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hQbot
    obtain ⟨n, b, hpb, hab⟩ :=
      WfDvdMonoid.max_power_factor' (x := p) ha0 hp.not_isUnit
    have hbQ : b ∉ Q := fun hb => hpb (mem_span_singleton.mp (hQp.le hb))
    have hpowQ : p ^ n ∈ Q :=
      (hQ.mem_or_mem (show p ^ n * b ∈ Q from hab ▸ haQ)).resolve_right hbQ
    exact hQp.not_ge ((span_singleton_le_iff_mem Q).mpr (hQ.mem_of_pow_mem n hpowQ))
  simp [hQbot]

/-- A prime non-zero-divisor in a commutative ring with well-founded `DvdNotUnit` generates an
ideal of height one. This combines the principal-prime upper bound with Mathlib's height lower
bound for a generator in `nonZeroDivisors R`, without a domain or Noetherian hypothesis. -/
theorem height_span_singleton_eq_one_of_prime_of_mem_nonZeroDivisors
    {R : Type u} [CommRing R] [WfDvdMonoid R] {p : R}
    (hp : Prime p) (hpreg : p ∈ nonZeroDivisors R) : (span {p}).height = 1 :=
  le_antisymm (height_span_singleton_le_one_of_prime hp)
    (one_le_height_span_singleton_of_mem_nonZeroDivisors hpreg)

/-- A prime element in a commutative domain with well-founded `DvdNotUnit` generates an ideal
of height one. Regularity follows from `Prime.ne_zero`; no Noetherian hypothesis is needed. -/
theorem height_span_singleton_eq_one_of_prime
    {R : Type u} [CommRing R] [IsDomain R] [WfDvdMonoid R] {p : R} (hp : Prime p) :
    (span {p}).height = 1 :=
  height_span_singleton_eq_one_of_prime_of_mem_nonZeroDivisors hp
    (mem_nonZeroDivisors_of_ne_zero hp.ne_zero)

end Ideal
