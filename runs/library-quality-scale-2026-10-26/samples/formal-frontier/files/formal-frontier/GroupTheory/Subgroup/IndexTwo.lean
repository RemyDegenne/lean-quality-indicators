module

public import Mathlib.GroupTheory.IndexNormal
public import Mathlib.GroupTheory.SpecificGroups.Cyclic
public import Mathlib.GroupTheory.Schreier

/-!
# Index-two subgroups and two-element characters

An index-two subgroup determines a unique nontrivial homomorphism to
`Multiplicative (ZMod 2)`. The kernel construction gives the inverse correspondence.
The domain is an arbitrary group, including the trivial group. Normality is derived
from the index, not required as additional input.

Two word-generation formulas apply to any group generated by a pair. In the first,
one generator lies outside the subgroup and one lies inside; in the second, both
lie outside. These are generation statements, not assertions of freeness.

## References

* J. P. May, *A Concise Course in Algebraic Topology*, Chapter 4, Problem 1, p. 38.
* Mathlib's quotient-group and prime-cardinality equivalences supply the character.
* `Subgroup.closure_mul_image_eq` in `Mathlib.GroupTheory.Schreier` supplies the
  subgroup-generation theorem for a right transversal.
-/

@[expose] public section

universe u v

namespace MonoidHom

variable {G : Type u} [Group G] {A : Type v} [Group A]

/-- Homomorphisms to a two-element group are determined by their kernels, including
when the homomorphisms are trivial. -/
theorem ker_injective_of_card_eq_two (hA : Nat.card A = 2) :
    Function.Injective (fun χ : G →* A => χ.ker) := by
  classical
  intro χ ψ hker
  change χ.ker = ψ.ker at hker
  ext g
  have hg : χ g = 1 ↔ ψ g = 1 := by
    change g ∈ χ.ker ↔ g ∈ ψ.ker
    rw [hker]
  by_cases hχg : χ g = 1
  · exact hχg.trans (hg.mp hχg).symm
  · exact ((Nat.card_eq_two_iff' (1 : A)).mp hA).unique hχg (mt hg.mpr hχg)

/-- A homomorphism to a two-element group has index-two kernel exactly when it is
nontrivial. No finiteness assumption on the domain is required. -/
theorem ker_index_eq_two_iff (hA : Nat.card A = 2) (χ : G →* A) :
    χ.ker.index = 2 ↔ χ ≠ 1 := by
  classical
  constructor
  · intro hindex hχ
    rw [hχ, ker_one, Subgroup.index_top] at hindex
    exact (by decide : (1 : ℕ) ≠ 2) hindex
  · intro hχ
    have hex : ∃ g, χ g ≠ 1 := by
      by_contra h
      apply hχ
      ext g
      exact not_not.mp (fun hg => h ⟨g, hg⟩)
    obtain ⟨g, hg⟩ := hex
    have hsurj : Function.Surjective χ := by
      intro a
      by_cases ha : a = 1
      · exact ⟨1, (map_one χ).trans ha.symm⟩
      · exact ⟨g, ((Nat.card_eq_two_iff' (1 : A)).mp hA).unique hg ha⟩
    rw [← MonoidHom.comap_bot, (⊥ : Subgroup A).index_comap_of_surjective hsurj,
      Subgroup.index_bot, hA]

end MonoidHom

namespace Subgroup

variable {G : Type u} [Group G]

/-- The character of an index-two subgroup, obtained by identifying its quotient
with the additive group of `ZMod 2`, written multiplicatively. -/
noncomputable def characterOfIndexTwo (H : Subgroup G) (hH : H.index = 2) :
    G →* Multiplicative (ZMod 2) := by
  let : H.Normal := normal_of_index_eq_two hH
  exact (mulEquivOfPrimeCardEq (p := 2)
    (H.index_eq_card.symm.trans hH)
    (by simp [Nat.card_eq_fintype_card])).toMonoidHom.comp (QuotientGroup.mk' H)

/-- The character takes the identity value exactly on the subgroup. -/
@[simp] theorem characterOfIndexTwo_apply_eq_one_iff
    (H : Subgroup G) (hH : H.index = 2) (g : G) :
    H.characterOfIndexTwo hH g = 1 ↔ g ∈ H := by
  let : H.Normal := normal_of_index_eq_two hH
  simp only [characterOfIndexTwo, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
    MulEquiv.map_eq_one_iff, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]

/-- Outside the subgroup, the character takes the unique nonidentity value. -/
theorem characterOfIndexTwo_apply_of_notMem
    (H : Subgroup G) (hH : H.index = 2) (g : G) (hg : g ∉ H) :
    H.characterOfIndexTwo hH g = Multiplicative.ofAdd (1 : ZMod 2) := by
  apply ((Nat.card_eq_two_iff' (1 : Multiplicative (ZMod 2))).mp
    (by simp [Nat.card_eq_fintype_card])).unique
  · exact (H.characterOfIndexTwo_apply_eq_one_iff hH g).not.mpr hg
  · change (1 : ZMod 2) ≠ 0
    exact one_ne_zero

/-- The kernel of the character recovers the index-two subgroup. -/
@[simp] theorem ker_characterOfIndexTwo (H : Subgroup G) (hH : H.index = 2) :
    (H.characterOfIndexTwo hH).ker = H := by
  ext g
  exact H.characterOfIndexTwo_apply_eq_one_iff hH g

/-- The character of an index-two subgroup is nontrivial. -/
theorem characterOfIndexTwo_ne_one (H : Subgroup G) (hH : H.index = 2) :
    H.characterOfIndexTwo hH ≠ 1 := by
  apply (MonoidHom.ker_index_eq_two_iff (by simp [Nat.card_eq_fintype_card]) _).mp
  simpa only [ker_characterOfIndexTwo] using hH

/-- A character with the prescribed index-two kernel is the subgroup's character. -/
theorem characterOfIndexTwo_unique (H : Subgroup G) (hH : H.index = 2)
    (χ : G →* Multiplicative (ZMod 2)) (hχ : χ.ker = H) :
    χ = H.characterOfIndexTwo hH := by
  apply MonoidHom.ker_injective_of_card_eq_two (by simp [Nat.card_eq_fintype_card])
  exact hχ.trans (H.ker_characterOfIndexTwo hH).symm

/-- Equality with the subgroup's character is equivalent to having that kernel. -/
theorem eq_characterOfIndexTwo_iff (H : Subgroup G) (hH : H.index = 2)
    (χ : G →* Multiplicative (ZMod 2)) :
    χ = H.characterOfIndexTwo hH ↔ χ.ker = H := by
  constructor
  · rintro rfl
    exact H.ker_characterOfIndexTwo hH
  · exact H.characterOfIndexTwo_unique hH χ

/-- Index-two subgroups correspond to nontrivial characters to the two-element group. -/
noncomputable def indexTwoEquivNontrivialHom :
    {H : Subgroup G // H.index = 2} ≃
      {χ : G →* Multiplicative (ZMod 2) // χ ≠ 1} where
  toFun H := ⟨H.val.characterOfIndexTwo H.property,
    H.val.characterOfIndexTwo_ne_one H.property⟩
  invFun χ := ⟨χ.val.ker,
    (MonoidHom.ker_index_eq_two_iff (by simp [Nat.card_eq_fintype_card]) χ.val).mpr
      χ.property⟩
  left_inv H := Subtype.ext (H.val.ker_characterOfIndexTwo H.property)
  right_inv χ := by
    apply Subtype.ext
    symm
    exact χ.val.ker.characterOfIndexTwo_unique
      ((MonoidHom.ker_index_eq_two_iff (by simp [Nat.card_eq_fintype_card]) χ.val).mpr
        χ.property) χ.val rfl

/-- The forward correspondence is the characteristic character. -/
@[simp] theorem indexTwoEquivNontrivialHom_apply_val
    (H : Subgroup G) (hH : H.index = 2) :
    (indexTwoEquivNontrivialHom (G := G) ⟨H, hH⟩).val =
      H.characterOfIndexTwo hH := rfl

/-- The inverse correspondence takes the kernel. -/
@[simp] theorem indexTwoEquivNontrivialHom_symm_apply_val
    (χ : G →* Multiplicative (ZMod 2)) (hχ : χ ≠ 1) :
    ((indexTwoEquivNontrivialHom (G := G)).symm ⟨χ, hχ⟩).val = χ.ker := rfl

/-- Applying the characteristic construction to the kernel recovers a nontrivial
character. -/
@[simp] theorem characterOfIndexTwo_ker
    (χ : G →* Multiplicative (ZMod 2)) (hχ : χ ≠ 1) :
    χ.ker.characterOfIndexTwo
      ((MonoidHom.ker_index_eq_two_iff (by simp [Nat.card_eq_fintype_card]) χ).mpr hχ) = χ := by
  exact (χ.ker.characterOfIndexTwo_unique _ χ rfl).symm

/-- A subgroup has index two exactly when it is the kernel of a unique nontrivial
character to the two-element group. -/
theorem index_eq_two_iff_existsUnique_nontrivial_hom (H : Subgroup G) :
    H.index = 2 ↔ ∃! χ : G →* Multiplicative (ZMod 2), χ ≠ 1 ∧ χ.ker = H := by
  constructor
  · intro hH
    exact ⟨H.characterOfIndexTwo hH,
      ⟨H.characterOfIndexTwo_ne_one hH, H.ker_characterOfIndexTwo hH⟩,
      fun χ hχ => H.characterOfIndexTwo_unique hH χ hχ.2⟩
  · rintro ⟨χ, ⟨hχ, hker⟩, _⟩
    rw [← hker]
    exact (MonoidHom.ker_index_eq_two_iff (by simp [Nat.card_eq_fintype_card]) χ).mpr hχ

/-- Pullback of an index-two subgroup along a surjection corresponds to precomposition
of its character. Surjectivity ensures that the character remains nontrivial. -/
theorem characterOfIndexTwo_comap (H : Subgroup G) (hH : H.index = 2)
    {G' : Type v} [Group G'] (f : G' →* G) (hf : Function.Surjective f) :
    (H.comap f).characterOfIndexTwo ((H.index_comap_of_surjective hf).trans hH) =
      (H.characterOfIndexTwo hH).comp f := by
  apply MonoidHom.ker_injective_of_card_eq_two (by simp [Nat.card_eq_fintype_card])
  change ((H.comap f).characterOfIndexTwo _).ker = ((H.characterOfIndexTwo hH).comp f).ker
  rw [ker_characterOfIndexTwo, ← MonoidHom.comap_ker, ker_characterOfIndexTwo]

-- Right cosets have representatives `1` and `a`, selected by membership in `H`.
private theorem isComplement_pair_of_index_eq_two
    (H : Subgroup G) (hindex : H.index = 2) (a : G) (ha : a ∉ H) :
    IsComplement (H : Set G) ({1, a} : Set G) := by
  classical
  refine isComplement_iff_existsUnique_mul_inv_mem.mpr fun g => ?_
  by_cases hg : g ∈ H
  · refine ⟨⟨1, by simp⟩, by simpa using hg, ?_⟩
    rintro ⟨r, hr⟩ hgr
    apply Subtype.ext
    rcases (show r = 1 ∨ r = a by simpa using hr) with rfl | rfl
    · rfl
    · exact False.elim (ha (by
        simpa using H.inv_mem ((H.mul_mem_cancel_left hg).mp hgr)))
  · refine ⟨⟨a, by simp⟩, ?_, ?_⟩
    · exact (mul_mem_iff_of_index_two hindex).mpr (by simp [hg, ha])
    · rintro ⟨r, hr⟩ hgr
      apply Subtype.ext
      rcases (show r = 1 ∨ r = a by simpa using hr) with rfl | rfl
      · exact False.elim (hg (by simpa using hgr))
      · rfl

open Classical in
private theorem toRightFun_pair_eq
    (H : Subgroup G) (a : G) (hR : IsComplement (H : Set G) ({1, a} : Set G))
    (g : G) : (hR.toRightFun g : G) = if g ∈ H then 1 else a := by
  classical
  by_cases hg : g ∈ H
  · rw [ite_eq_left hg]
    exact congrArg Subtype.val
      ((isComplement_iff_existsUnique_mul_inv_mem.mp hR g).unique
        (hR.mul_inv_toRightFun_mem g)
        (show g * ((⟨1, by simp⟩ : ({1, a} : Set G)) : G)⁻¹ ∈ (H : Set G) by
          simpa using hg))
  · rw [ite_eq_right hg]
    rcases (show (hR.toRightFun g : G) = 1 ∨ (hR.toRightFun g : G) = a by
      simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using
        (hR.toRightFun g).property) with hr | hr
    · exact False.elim (hg (by simpa [hr] using hR.mul_inv_toRightFun_mem g))
    · exact hr

/-- If a group is generated by `a,b`, and an index-two subgroup contains `b` but
not `a`, that subgroup is generated by `a²`, `b`, and `a * b * a⁻¹`. -/
theorem closure_sq_pair_conj_eq_of_index_eq_two
    (H : Subgroup G) (hindex : H.index = 2) (a b : G)
    (hgen : closure ({a, b} : Set G) = ⊤) (ha : a ∉ H) (hb : b ∈ H) :
    closure ({a ^ 2, b, a * b * a⁻¹} : Set G) = H := by
  classical
  have haa : a * a ∈ H := mul_self_mem_of_index_two hindex a
  have hab : a * b ∉ H := by
    simpa only [mul_mem_iff_of_index_two hindex, hb, iff_true] using ha
  have hconj : a * b * a⁻¹ ∈ H :=
    (mul_mem_iff_of_index_two hindex).mpr (by simp [hab, ha])
  have hR := isComplement_pair_of_index_eq_two H hindex a ha
  refine le_antisymm ((closure_le H).mpr ?_) ?_
  · intro g hg
    rcases Set.mem_insert_iff.mp hg with rfl | hg
    · exact sq_mem_of_index_two hindex a
    rcases (show g = b ∨ g = a * b * a⁻¹ by simpa using hg) with rfl | rfl
    · exact hb
    · exact hconj
  · -- Schreier's four generators are `1`, `b`, `a²`, and `a * b * a⁻¹`.
    rw [← closure_mul_image_eq hR (by simp) hgen, closure_le]
    rintro _ ⟨_, ⟨r, hr, s, hs, rfl⟩, rfl⟩
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hr hs
    rcases hr with hr | hr <;> rcases hs with hs | hs <;> rw [hr, hs]
    · simp only [one_mul, toRightFun_pair_eq H a hR, ite_eq_right ha, mul_inv_cancel]
      exact (closure _).one_mem
    · simp only [one_mul, toRightFun_pair_eq H a hR, ite_eq_left hb, inv_one, mul_one]
      exact subset_closure (by simp)
    · simp only [toRightFun_pair_eq H a hR, ite_eq_left haa, inv_one, mul_one]
      exact subset_closure (by simp [pow_two])
    · simp only [toRightFun_pair_eq H a hR, ite_eq_right hab]
      exact subset_closure (by simp)

/-- If a group is generated by `a,b`, and both generators lie outside an index-two
subgroup, that subgroup is generated by `a²`, `b * a⁻¹`, and `a * b`. -/
theorem closure_sq_pair_mul_eq_of_index_eq_two
    (H : Subgroup G) (hindex : H.index = 2) (a b : G)
    (hgen : closure ({a, b} : Set G) = ⊤) (ha : a ∉ H) (hb : b ∉ H) :
    closure ({a ^ 2, b * a⁻¹, a * b} : Set G) = H := by
  classical
  have haa : a * a ∈ H := mul_self_mem_of_index_two hindex a
  have hab : a * b ∈ H :=
    (mul_mem_iff_of_index_two hindex).mpr (by simp [ha, hb])
  have hba : b * a⁻¹ ∈ H :=
    (mul_mem_iff_of_index_two hindex).mpr (by simp [ha, hb])
  have hR := isComplement_pair_of_index_eq_two H hindex a ha
  refine le_antisymm ((closure_le H).mpr ?_) ?_
  · intro g hg
    rcases Set.mem_insert_iff.mp hg with rfl | hg
    · exact sq_mem_of_index_two hindex a
    rcases (show g = b * a⁻¹ ∨ g = a * b by simpa using hg) with rfl | rfl
    · exact hba
    · exact hab
  · -- Schreier's four generators are `1`, `b * a⁻¹`, `a²`, and `a * b`.
    rw [← closure_mul_image_eq hR (by simp) hgen, closure_le]
    rintro _ ⟨_, ⟨r, hr, s, hs, rfl⟩, rfl⟩
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hr hs
    rcases hr with hr | hr <;> rcases hs with hs | hs <;> rw [hr, hs]
    · simp only [one_mul, toRightFun_pair_eq H a hR, ite_eq_right ha, mul_inv_cancel]
      exact (closure _).one_mem
    · simp only [one_mul, toRightFun_pair_eq H a hR, ite_eq_right hb]
      exact subset_closure (by simp)
    · simp only [toRightFun_pair_eq H a hR, ite_eq_left haa, inv_one, mul_one]
      exact subset_closure (by simp [pow_two])
    · simp only [toRightFun_pair_eq H a hR, ite_eq_left hab, inv_one, mul_one]
      exact subset_closure (by simp)

end Subgroup
