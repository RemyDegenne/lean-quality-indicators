module

import AdicModules.RingTheory.Ideal.Operations
public import Mathlib.Algebra.Ring.Defs
public import Mathlib.RingTheory.Ideal.Operations
public import Mathlib.Topology.Algebra.Group.Defs
import Mathlib.Topology.Algebra.Group.Neighborhood

/-!
# Density of ideals in powers topologies

If the powers of a left ideal `I` form a neighborhood basis at zero in a
ring with a compatible additive group topology, a left ideal `J` is dense
exactly when `J ⊔ I = ⊤`. Neither ideal needs to be two-sided, and multiplication
need not be continuous.

Translating the basis at zero gives a neighborhood basis at each ring element.
Density therefore means that every coset of every ideal power meets `J`.
The algebraic theorem `Ideal.sup_pow_eq_top_of_sup_eq_top` passes from
`J ⊔ I = ⊤` to `J ⊔ I ^ n = ⊤` for every natural number `n`, so each
ring element decomposes as a sum of an element of `J` and an element of `I ^ n`.
All powers and sums are formed as ideals over the original ring.

For example, the proper ideal generated by `3` is dense in the integers
with the topology defined by powers of the ideal generated by `2`.
The explicit powers topology is essential: the same ideal is not dense in
the discrete integers.

## References

* Mathlib's ideal and submodule APIs, especially `Submodule.mem_sup` and
  `Submodule.sub_mem_sup`.
* Mathlib's topological-group neighborhood and closure APIs, especially
  `Filter.HasBasis.nhds_of_zero` and `mem_closure_iff_nhds_basis`.
* `Ideal.sup_pow_eq_top_of_sup_eq_top` in
  `AdicModules.RingTheory.Ideal.Operations`, whose subtraction-free recurrence
  supplies the comaximal-power step.
-/

@[expose] public section

universe u
open Filter Topology

/-- A left ideal is dense in a compatible additive group topology with an
ideal-power basis at zero if and only if its sum with the filtration ideal is
all of the ring. Both ideals may be arbitrary left ideals. The proof uses
translated neighborhood bases and comaximality of all ideal powers. -/
theorem Ideal.dense_iff_sup_eq_top_of_hasBasis
    {R : Type u} [Ring R] [TopologicalSpace R] [IsTopologicalAddGroup R]
    {I J : Ideal R}
    (hI : (𝓝 (0 : R)).HasBasis (fun _n : ℕ ↦ True)
      (fun n ↦ ((I ^ n : Ideal R) : Set R))) :
    Dense (J : Set R) ↔ J ⊔ I = ⊤ := by
  constructor
  · intro hJ
    obtain ⟨j, hj, hjI⟩ :=
      (mem_closure_iff_nhds_basis (hI.nhds_of_zero (1 : R))).mp (hJ 1) 1 trivial
    have hjI' : j - 1 ∈ I := by
      change j - 1 ∈ (I ^ 1 : Ideal R) at hjI
      simpa only [Submodule.pow_one] using hjI
    apply (Ideal.eq_top_iff_one (J ⊔ I)).mpr
    simpa only [sub_sub_cancel] using Submodule.sub_mem_sup hj hjI'
  · intro h r
    apply (mem_closure_iff_nhds_basis (hI.nhds_of_zero r)).mpr
    intro n _
    have hr : r ∈ J ⊔ I ^ n := by
      rw [Ideal.sup_pow_eq_top_of_sup_eq_top (n := n) h]
      exact Submodule.mem_top
    obtain ⟨j, hj, i, hi, hji⟩ := Submodule.mem_sup.mp hr
    refine ⟨j, hj, ?_⟩
    change j - r ∈ I ^ n
    rw [← hji, sub_add_cancel_left]
    exact (I ^ n).neg_mem hi
