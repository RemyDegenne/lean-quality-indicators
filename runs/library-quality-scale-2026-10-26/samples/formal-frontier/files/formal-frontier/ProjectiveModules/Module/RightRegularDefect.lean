module

public import Mathlib.Algebra.Module.Opposite
public import Mathlib.LinearAlgebra.Prod
public import Mathlib.LinearAlgebra.Span.Defs
public import Mathlib.LinearAlgebra.Projection

/-!
# The defect of a specified right inverse

Let `R` be a ring and let `x * y = 1`. Left multiplication by `x` is a split
surjection on the right regular module, with section given by left multiplication
by `y`. Its kernel is the principal right submodule generated by `1 - y * x`.
Consequently, the right regular module decomposes as the product of `R` and that
submodule.

The scalar ring is `Rᵐᵒᵖ`, acting on the carrier `R` by
`MulOpposite.op t • r = r * t`. Thus the singleton span below describes a
right submodule; no left-ideal or two-sided-ideal condition is imposed. The
equivalence has coordinates `r ↦ (x * r, (1 - y * x) * r)` and inverse
`(s, p) ↦ y * s + p`, with the second forward coordinate regarded as an
element of the singleton span. The span vanishes exactly when `y * x = 1`.

No commutativity, nontriviality, finiteness, projectivity or rank hypothesis is
needed. This is an elementary ring/module decomposition; it does not construct
product-ring or rank witnesses.

## Formalization approach

This module follows Mathlib's opposite-module and singleton-span formalizations.
Mathlib's `LinearMap.equivProdOfSurjectiveOfIsCompl` provides the general
splitting machinery. Left multiplication by `x` and the projection given by
left multiplication by `1 - y * x` are surjective maps with complementary
kernels. Only the kernel identification and characteristic formulas are
specific to the defect `1 - y * x`.

## References

- C. Weibel, *The K-book: An Introduction to Algebraic K-theory*, §I.1,
  for rings and right modules.
- Mathlib's opposite-module, singleton-span and complementary-kernel
  linear-equivalence formalizations.
-/

@[expose] public section

universe u

variable {R : Type u} [Ring R] {x y : R}

namespace LinearMap

/-- If `x * y = 1`, the kernel of left multiplication by `x` on the right
regular module is the right submodule generated by `1 - y * x`. -/
theorem ker_mulLeft_eq_span_one_sub_mul_of_mul_eq_one (hxy : x * y = 1) :
    LinearMap.ker (LinearMap.mulLeft Rᵐᵒᵖ x) =
      Submodule.span Rᵐᵒᵖ ({1 - y * x} : Set R) := by
  have hs : (LinearMap.mulLeft Rᵐᵒᵖ x).comp
      (LinearMap.mulLeft Rᵐᵒᵖ y) = LinearMap.id := by
    apply LinearMap.ext
    intro r
    simp only [LinearMap.comp_apply, LinearMap.mulLeft_apply, LinearMap.id_apply]
    rw [← mul_assoc, hxy, one_mul]
  have he : (LinearMap.id : R →ₗ[Rᵐᵒᵖ] R) -
      (LinearMap.mulLeft Rᵐᵒᵖ y).comp (LinearMap.mulLeft Rᵐᵒᵖ x) =
      LinearMap.mulLeft Rᵐᵒᵖ (1 - y * x) := by
    apply LinearMap.ext
    intro r
    simp only [LinearMap.sub_apply, LinearMap.id_apply, LinearMap.comp_apply,
      LinearMap.mulLeft_apply, sub_mul, one_mul, mul_assoc]
  rw [LinearMap.ker_eq_range_of_comp_eq_id hs, he]
  ext r
  rw [LinearMap.mem_range, Submodule.mem_span_singleton]
  constructor
  · rintro ⟨s, hs⟩
    exact ⟨MulOpposite.op s, by
      simpa only [op_smul_eq_mul, LinearMap.mulLeft_apply] using hs⟩
  · rintro ⟨a, ha⟩
    exact ⟨MulOpposite.unop a, by
      simpa only [MulOpposite.smul_eq_mul_unop, LinearMap.mulLeft_apply] using ha⟩

end LinearMap

namespace Submodule

/-- Membership in the right submodule generated by the defect is equivalent
to annihilation by left multiplication by `x`. -/
theorem mem_span_one_sub_mul_iff_of_mul_eq_one (hxy : x * y = 1) (r : R) :
    r ∈ Submodule.span Rᵐᵒᵖ ({1 - y * x} : Set R) ↔ x * r = 0 := by
  rw [← LinearMap.ker_mulLeft_eq_span_one_sub_mul_of_mul_eq_one hxy]
  simp only [LinearMap.mem_ker, LinearMap.mulLeft_apply]

/-- The right submodule generated by `1 - y * x` vanishes exactly when
`y * x = 1`. This equivalence does not require `x * y = 1`. -/
theorem span_one_sub_mul_eq_bot_iff (x y : R) :
    Submodule.span Rᵐᵒᵖ ({1 - y * x} : Set R) = ⊥ ↔ y * x = 1 := by
  rw [Submodule.span_singleton_eq_bot, sub_eq_zero, eq_comm]

/-- Failure of the reverse inverse identity gives a nonzero defect submodule. -/
theorem span_one_sub_mul_ne_bot (hyx : y * x ≠ 1) :
    Submodule.span Rᵐᵒᵖ ({1 - y * x} : Set R) ≠ ⊥ := by
  exact fun h => hyx ((span_one_sub_mul_eq_bot_iff x y).mp h)

end Submodule

namespace LinearEquiv

/-- The right regular module of a ring with a specified pair `x * y = 1`
is the product of the right regular module and the right submodule generated
by `1 - y * x`.

The first coordinate is `x * r`, the underlying second coordinate is
`(1 - y * x) * r`, and the inverse sends `(s, p)` to `y * s + (p : R)`. -/
noncomputable def rightRegularEquivProdOfMulEqOne (hxy : x * y = 1) :
    R ≃ₗ[Rᵐᵒᵖ] (R × Submodule.span Rᵐᵒᵖ ({1 - y * x} : Set R)) := by
  let D : Submodule Rᵐᵒᵖ R := Submodule.span Rᵐᵒᵖ ({1 - y * x} : Set R)
  let q : R →ₗ[Rᵐᵒᵖ] D :=
    (LinearMap.mulLeft Rᵐᵒᵖ (1 - y * x)).codRestrict D (fun r =>
      Submodule.mem_span_singleton.mpr
        ⟨MulOpposite.op r, by rw [op_smul_eq_mul]; rfl⟩)
  have hq : ∀ p : D, q (p : R) = p := by
    intro p
    apply Subtype.ext
    change (1 - y * x) * (p : R) = (p : R)
    have hp : x * (p : R) = 0 :=
      (Submodule.mem_span_one_sub_mul_iff_of_mul_eq_one hxy _).mp p.property
    simp only [sub_mul, one_mul, mul_assoc, hp, mul_zero, sub_zero]
  have hf : LinearMap.range (LinearMap.mulLeft Rᵐᵒᵖ x) = ⊤ := by
    apply LinearMap.range_eq_top.mpr
    intro s
    exact ⟨y * s, by rw [LinearMap.mulLeft_apply, ← mul_assoc, hxy, one_mul]⟩
  have hc : IsCompl (LinearMap.ker (LinearMap.mulLeft Rᵐᵒᵖ x))
      (LinearMap.ker q) := by
    rw [LinearMap.ker_mulLeft_eq_span_one_sub_mul_of_mul_eq_one hxy]
    exact LinearMap.isCompl_of_proj hq
  exact LinearMap.equivProdOfSurjectiveOfIsCompl
    (LinearMap.mulLeft Rᵐᵒᵖ x) q hf (LinearMap.range_eq_of_proj hq) hc

/-- The first coordinate of the right regular decomposition is left
multiplication by `x`. -/
@[simp] theorem rightRegularEquivProdOfMulEqOne_apply_fst
    (hxy : x * y = 1) (r : R) :
    (rightRegularEquivProdOfMulEqOne hxy r).1 = x * r := by
  rfl

/-- After forgetting membership in the singleton span, the second coordinate
of the right regular decomposition is left multiplication by the defect. -/
@[simp] theorem rightRegularEquivProdOfMulEqOne_apply_snd_coe
    (hxy : x * y = 1) (r : R) :
    ((rightRegularEquivProdOfMulEqOne hxy r).2 : R) = (1 - y * x) * r := by
  rfl

/-- The inverse right regular decomposition adds the chosen section to the
inclusion of the defect submodule. -/
@[simp] theorem rightRegularEquivProdOfMulEqOne_symm_apply
    (hxy : x * y = 1) (s : R)
    (p : Submodule.span Rᵐᵒᵖ ({1 - y * x} : Set R)) :
    (rightRegularEquivProdOfMulEqOne hxy).symm (s, p) = y * s + (p : R) := by
  have hp : x * (p : R) = 0 :=
    (Submodule.mem_span_one_sub_mul_iff_of_mul_eq_one hxy _).mp p.property
  have hs : x * (y * s + (p : R)) = s := by
    rw [mul_add, ← mul_assoc, hxy, one_mul, hp, add_zero]
  apply (rightRegularEquivProdOfMulEqOne hxy).injective
  rw [LinearEquiv.apply_symm_apply]
  apply Prod.ext
  · change s = (rightRegularEquivProdOfMulEqOne hxy (y * s + (p : R))).1
    rw [rightRegularEquivProdOfMulEqOne_apply_fst, hs]
  · apply Subtype.ext
    change (p : R) =
      ((rightRegularEquivProdOfMulEqOne hxy (y * s + (p : R))).2 : R)
    rw [rightRegularEquivProdOfMulEqOne_apply_snd_coe,
      sub_mul, one_mul, mul_assoc, hs, add_sub_cancel_left]

end LinearEquiv
