module

public import ProjectiveModules.Category.FiniteProjective
public import Mathlib.LinearAlgebra.DirectSum.Finite
public import Mathlib.RingTheory.Spectrum.Prime.FreeLocus

/-!
# Realizing locally constant stalk-rank functions

This file constructs a finite projective module with any prescribed locally
constant natural-valued function on `PrimeSpectrum R` as its full stalk-rank
function.  The construction uses the idempotents of the clopen threshold sets
`{p | i < f p}`.  It also constructs the componentwise complementary module
and an explicit equivalence of their product with a finite standard free
module.

The supporting idempotent API uses the canonical left ideal `Ideal.span {e}`.
Over any semiring its projection is right multiplication `r ↦ r * e`, and an
idempotent gives a retraction and a projective ideal. Over any ring the two
complementary left ideals have a product linearly equivalent to the ring, by
addition, with inverse `r ↦ (r * e, r * (1 - e))`. Centrality is not required.

Stalk ranks and locally constant prime-spectrum theory remain over commutative
rings. Over a commutative semiring the idempotent ideal is free exactly for the
zero and unit idempotents. The nonfreeness argument uses Mathlib's faithful
scalar action on a nontrivial free module; no nontriviality assumption on the
scalars is needed. Left multiplication by a noncentral idempotent need not fix
the members of its left ideal.
-/

public section

open Function Set

universe u

namespace IsIdempotentElem

section Semiring

variable {R : Type u} [Semiring R] {e : R}

/-- Right multiplication by `e` with codomain the canonical principal left
ideal. Idempotence is not needed to define this linear map. -/
@[expose] noncomputable def spanProjection (e : R) :
    R →ₗ[R] Ideal.span {e} :=
  (LinearMap.toSpanSingleton R R e).codRestrict (Ideal.span {e}) fun r ↦ by
    rw [LinearMap.toSpanSingleton_apply, smul_eq_mul]
    exact Ideal.mem_span_singleton'.2 ⟨r, rfl⟩

/-- The underlying scalar of the principal-ideal projection is `r * e`. -/
@[simp]
lemma spanProjection_apply (e r : R) : (spanProjection e r : R) = r * e := by
  simp only [spanProjection, LinearMap.codRestrict_apply,
    LinearMap.toSpanSingleton_apply, smul_eq_mul]

/-- The projection sends one to the canonical generator of the ideal. -/
@[simp]
lemma spanProjection_apply_one (e : R) :
    spanProjection e 1 = ⟨e, Ideal.mem_span_singleton_self e⟩ := by
  apply Subtype.ext
  simp

/-- Inclusion after projection is the usual map to scalar multiples of `e`. -/
@[simp]
lemma subtype_comp_spanProjection (e : R) :
    (Ideal.span {e}).subtype ∘ₗ spanProjection e = LinearMap.toSpanSingleton R R e := by
  ext
  simp

/-- The idempotent-span projection retracts the inclusion into the base ring. -/
lemma spanProjection_comp_subtype (he : IsIdempotentElem e) :
    spanProjection e ∘ₗ (Ideal.span {e}).subtype = LinearMap.id := by
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  change (spanProjection e (x : R) : R) = (x : R)
  rw [spanProjection_apply]
  obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.1 x.property
  rw [← ha, mul_assoc, he.eq]

/-- The projection fixes an element already in the idempotent ideal. -/
@[simp]
lemma spanProjection_apply_coe (he : IsIdempotentElem e) (x : Ideal.span {e}) :
    spanProjection e (x : R) = x := by
  exact DFunLike.congr_fun he.spanProjection_comp_subtype x

/-- The principal left ideal generated by an idempotent is projective. -/
theorem projective_span (he : IsIdempotentElem e) :
    Module.Projective R (Ideal.span {e}) := by
  exact Module.Projective.of_split (Ideal.span {e}).subtype (spanProjection e)
    he.spanProjection_comp_subtype

end Semiring

section CommSemiring

variable {R : Type u} [CommSemiring R] {e : R}

/-- An idempotent acts as the identity on the ideal it generates. -/
@[simp]
lemma smul_span (he : IsIdempotentElem e) (x : Ideal.span {e}) : e • x = x := by
  apply Subtype.ext
  obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.1 x.property
  change e * (x : R) = (x : R)
  rw [← hr, mul_left_comm e r e, he.eq]

/-- Over a commutative semiring, an idempotent-generated ideal is free exactly
when its generator is zero or one. The zero ideal is free on an empty basis.
For a nonzero generator, Mathlib's faithful scalar action on a nontrivial free
module forces the idempotent, which acts identically, to equal one.

Commutativity is essential here: a proper nonzero idempotent-generated left
ideal of a noncommutative ring can be free. -/
theorem free_span_iff (he : IsIdempotentElem e) :
    Module.Free R (Ideal.span {e}) ↔ e = 0 ∨ e = 1 := by
  constructor
  · intro hfree
    by_cases h0 : e = 0
    · exact Or.inl h0
    · let _ : Module.Free R (Ideal.span {e}) := hfree
      let _ : Nontrivial (Ideal.span {e}) := Submodule.nontrivial_span_singleton h0
      exact Or.inr (eq_of_smul_eq_smul fun x : Ideal.span {e} ↦ by
        rw [he.smul_span, one_smul])
  · rintro (rfl | rfl)
    · rw [Ideal.span_singleton_zero]
      infer_instance
    · rw [Ideal.span_singleton_one]
      exact Module.Free.of_equiv (Submodule.topEquiv (R := R) (M := R)).symm

/-- The ideal generated by a proper nonzero idempotent of a commutative semiring
is not free. Nontriviality of the ideal follows from the nonzero generator
rather than being an additional hypothesis. -/
theorem not_free_span (he : IsIdempotentElem e) (h0 : e ≠ 0) (h1 : e ≠ 1) :
    ¬ Module.Free R (Ideal.span {e}) :=
  fun hfree ↦ (he.free_span_iff.mp hfree).elim h0 h1

end CommSemiring

section Ring

variable {R : Type u} [Ring R] {e : R}

/-- Complementary idempotent left ideals sum to the ring. The inverse uses
right multiplication by `e` and `1 - e`; neither idempotent need be central. -/
@[expose] noncomputable def spanProdEquiv (he : IsIdempotentElem e) :
    (Ideal.span {e} × Ideal.span {1 - e}) ≃ₗ[R] R where
  toFun x := x.1.1 + x.2.1
  invFun r := (spanProjection e r, spanProjection (1 - e) r)
  left_inv x := by
    apply Prod.ext
    · change spanProjection e ((x.1 : R) + (x.2 : R)) = x.1
      rw [map_add, he.spanProjection_apply_coe]
      have hzero : spanProjection e (x.2 : R) = 0 := by
        apply Subtype.ext
        obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.1 x.2.property
        simp only [spanProjection_apply, Submodule.coe_zero]
        rw [← ha, mul_assoc, he.one_sub_mul_self, mul_zero]
      rw [hzero, add_zero]
    · change spanProjection (1 - e) ((x.1 : R) + (x.2 : R)) = x.2
      rw [map_add, he.one_sub.spanProjection_apply_coe]
      have hzero : spanProjection (1 - e) (x.1 : R) = 0 := by
        apply Subtype.ext
        obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.1 x.1.property
        simp only [spanProjection_apply, Submodule.coe_zero]
        rw [← ha, mul_assoc, he.mul_one_sub_self, mul_zero]
      rw [hzero, zero_add]
  right_inv r := by
    change (spanProjection e r : R) + (spanProjection (1 - e) r : R) = r
    rw [spanProjection_apply, spanProjection_apply, ← mul_add, add_sub_cancel, mul_one]
  map_add' x y := by simp only [Prod.fst_add, Prod.snd_add, Submodule.coe_add]; abel
  map_smul' r x := by simp [mul_add]

/-- The complementary-ideal equivalence adds the underlying scalars. -/
@[simp]
lemma spanProdEquiv_apply (he : IsIdempotentElem e)
    (x : Ideal.span {e} × Ideal.span {1 - e}) :
    he.spanProdEquiv x = (x.1 : R) + (x.2 : R) := rfl

/-- On the first summand the complementary-ideal equivalence is inclusion. -/
@[simp]
lemma spanProdEquiv_apply_left (he : IsIdempotentElem e) (x : Ideal.span {e}) :
    he.spanProdEquiv (x, 0) = (x : R) := by simp

/-- On the second summand the complementary-ideal equivalence is inclusion. -/
@[simp]
lemma spanProdEquiv_apply_right (he : IsIdempotentElem e) (x : Ideal.span {1 - e}) :
    he.spanProdEquiv (0, x) = (x : R) := by simp

/-- The inverse complementary-ideal equivalence is the pair of projections. -/
@[simp]
lemma spanProdEquiv_symm_apply (he : IsIdempotentElem e) (r : R) :
    he.spanProdEquiv.symm r = (spanProjection e r, spanProjection (1 - e) r) := rfl

/-- The first inverse coordinate has underlying scalar `r * e`. -/
@[simp]
lemma spanProdEquiv_symm_apply_fst (he : IsIdempotentElem e) (r : R) :
    ((he.spanProdEquiv.symm r).1 : R) = r * e := by simp

/-- The second inverse coordinate has underlying scalar `r * (1 - e)`. -/
@[simp]
lemma spanProdEquiv_symm_apply_snd (he : IsIdempotentElem e) (r : R) :
    ((he.spanProdEquiv.symm r).2 : R) = r * (1 - e) := by simp

end Ring

section CommRing

variable {R : Type u} [CommRing R] {e : R}

/-- The complementary idempotent annihilates the ideal generated by `e`. -/
@[simp]
lemma one_sub_smul_span (he : IsIdempotentElem e) (x : Ideal.span {e}) :
    (1 - e) • x = 0 := by
  rw [sub_smul, one_smul, he.smul_span, sub_self]

/-- The ideal generated by an idempotent has stalk rank zero at a prime
containing the idempotent. -/
lemma rankAtStalk_span_eq_zero (he : IsIdempotentElem e)
    (p : PrimeSpectrum R) (hp : e ∈ p.asIdeal) :
    Module.rankAtStalk (R := R) (Ideal.span {e}) p = 0 := by
  let _ : Module.Finite R (Ideal.span {e}) := Module.Finite.span_singleton R e
  let _ : Module.Projective R (Ideal.span {e}) := he.projective_span
  apply (Module.rankAtStalk_eq_zero_iff_notMem_support p).2
  rw [Module.notMem_support_iff']
  intro m
  refine ⟨1 - e, ?_, ?_⟩
  · intro hcomp
    apply (Ideal.ne_top_iff_one p.asIdeal).mp (inferInstance : p.asIdeal.IsPrime).ne_top
    simpa using p.asIdeal.add_mem hp hcomp
  · exact he.one_sub_smul_span m

/-- The ideal generated by an idempotent has stalk rank one at a prime not
containing the idempotent. -/
theorem rankAtStalk_span_eq_one (he : IsIdempotentElem e) (p : PrimeSpectrum R)
    (hp : e ∉ p.asIdeal) :
    Module.rankAtStalk (R := R) (Ideal.span {e}) p = 1 := by
  let _ : Module.Finite R (Ideal.span {e}) := Module.Finite.span_singleton R e
  let _ : Module.Projective R (Ideal.span {e}) := he.projective_span
  let _ : Module.Finite R (Ideal.span {1 - e}) := Module.Finite.span_singleton R (1 - e)
  let _ : Module.Projective R (Ideal.span {1 - e}) := he.one_sub.projective_span
  have he0 : e * (1 - e) = 0 := by rw [mul_sub, mul_one, he.eq, sub_self]
  have hcomp : 1 - e ∈ p.asIdeal :=
    ((inferInstance : p.asIdeal.IsPrime).mem_or_mem (he0 ▸ p.asIdeal.zero_mem)).resolve_left hp
  have hz := rankAtStalk_span_eq_zero he.one_sub p hcomp
  have hprod := congrFun
    (Module.rankAtStalk_prod (R := R) (Ideal.span {e}) (Ideal.span {1 - e})) p
  have hequiv := congrFun (Module.rankAtStalk_eq_of_equiv he.spanProdEquiv) p
  let _ : Nontrivial R := nontrivial_iff.mpr ⟨0, 1, fun h ↦ by
    apply (Ideal.ne_top_iff_one p.asIdeal).mp (inferInstance : p.asIdeal.IsPrime).ne_top
    rw [← h]
    exact p.asIdeal.zero_mem⟩
  calc
    Module.rankAtStalk (R := R) (Ideal.span {e}) p =
        Module.rankAtStalk (Ideal.span {e}) p + 0 := by simp
    _ = Module.rankAtStalk (Ideal.span {e}) p +
        Module.rankAtStalk (Ideal.span {1 - e}) p := by rw [hz]
    _ = Module.rankAtStalk (Ideal.span {e} × Ideal.span {1 - e}) p := hprod.symm
    _ = Module.rankAtStalk R p := hequiv
    _ = 1 := congrFun Module.rankAtStalk_self p

end CommRing

end IsIdempotentElem

namespace ModuleCat.FiniteProjective

variable {R : Type u} [CommRing R]

/-- A finite upper bound for a locally constant natural-valued function on a
prime spectrum. -/
noncomputable def rankBound (f : LocallyConstant (PrimeSpectrum R) ℕ) : ℕ :=
  f.range_finite.toFinset.sup id

/-- Every value of `f` is at most `rankBound f`. -/
lemma le_rankBound (f : LocallyConstant (PrimeSpectrum R) ℕ) (p : PrimeSpectrum R) :
    f p ≤ rankBound f := by
  unfold rankBound
  apply Finset.le_sup (f := id)
  exact f.range_finite.mem_toFinset.mpr (Set.mem_range_self p)

/-- The clopen threshold set on which the prescribed rank is greater than `i`. -/
def rankClopen (f : LocallyConstant (PrimeSpectrum R) ℕ)
    (i : Fin (rankBound f)) : TopologicalSpace.Clopens (PrimeSpectrum R) :=
  ⟨{p | i.1 < f p}, (isClopen_discrete _).preimage f.continuous⟩

/-- The idempotent cutting out the threshold set `rankClopen f i`. -/
noncomputable def rankIdempotent
    (f : LocallyConstant (PrimeSpectrum R) ℕ) (i : Fin (rankBound f)) : R :=
  (PrimeSpectrum.isIdempotentElemEquivClopens (R := R)).symm (rankClopen f i)

/-- A threshold idempotent is idempotent. -/
theorem rankIdempotent_isIdempotent
    (f : LocallyConstant (PrimeSpectrum R) ℕ) (i : Fin (rankBound f)) :
    IsIdempotentElem (rankIdempotent f i) :=
  ((PrimeSpectrum.isIdempotentElemEquivClopens (R := R)).symm (rankClopen f i)).2

/-- A threshold idempotent avoids precisely the primes where the rank is
strictly larger than its index. -/
theorem rankIdempotent_notMem_iff
    (f : LocallyConstant (PrimeSpectrum R) ℕ) (i : Fin (rankBound f))
    (p : PrimeSpectrum R) : rankIdempotent f i ∉ p.asIdeal ↔ i.1 < f p := by
  change p ∈ PrimeSpectrum.basicOpen (rankIdempotent f i) ↔ _
  unfold rankIdempotent
  rw [PrimeSpectrum.basicOpen_isIdempotentElemEquivClopens_symm (rankClopen f i)]
  rfl

/-- The explicit threshold-ideal module underlying
`ofLocallyConstantRank`. -/
abbrev rankModule (R : Type u) [CommRing R]
    (f : LocallyConstant (PrimeSpectrum R) ℕ) :=
  (i : Fin (rankBound f)) → Ideal.span {rankIdempotent f i}

private abbrev rankComplement (R : Type u) [CommRing R]
    (f : LocallyConstant (PrimeSpectrum R) ℕ) :=
  (i : Fin (rankBound f)) → Ideal.span {1 - rankIdempotent f i}

/-- The explicit threshold-ideal module is finitely generated. -/
theorem rankModuleFinite
    (f : LocallyConstant (PrimeSpectrum R) ℕ) : Module.Finite R (rankModule R f) := by
  let _ (i : Fin (rankBound f)) : Module.Finite R (Ideal.span {rankIdempotent f i}) :=
    Module.Finite.span_singleton R _
  exact Module.Finite.equiv
    (DirectSum.linearEquivFunOnFintype R (Fin (rankBound f))
      fun i ↦ Ideal.span {rankIdempotent f i})

/-- The explicit threshold-ideal module is projective. -/
theorem rankModuleProjective
    (f : LocallyConstant (PrimeSpectrum R) ℕ) : Module.Projective R (rankModule R f) := by
  let _ (i : Fin (rankBound f)) : Module.Projective R (Ideal.span {rankIdempotent f i}) :=
    (rankIdempotent_isIdempotent f i).projective_span
  exact Module.Projective.of_equiv'
    (DirectSum.linearEquivFunOnFintype R (Fin (rankBound f))
      fun i ↦ Ideal.span {rankIdempotent f i})

private lemma rankComplementFinite
    (f : LocallyConstant (PrimeSpectrum R) ℕ) : Module.Finite R (rankComplement R f) := by
  let _ (i : Fin (rankBound f)) : Module.Finite R (Ideal.span {1 - rankIdempotent f i}) :=
    Module.Finite.span_singleton R _
  exact Module.Finite.equiv
    (DirectSum.linearEquivFunOnFintype R (Fin (rankBound f))
      fun i ↦ Ideal.span {1 - rankIdempotent f i})

private lemma rankComplementProjective
    (f : LocallyConstant (PrimeSpectrum R) ℕ) : Module.Projective R (rankComplement R f) := by
  let _ (i : Fin (rankBound f)) : Module.Projective R
      (Ideal.span {1 - rankIdempotent f i}) :=
    (rankIdempotent_isIdempotent f i).one_sub.projective_span
  exact Module.Projective.of_equiv'
    (DirectSum.linearEquivFunOnFintype R (Fin (rankBound f))
      fun i ↦ Ideal.span {1 - rankIdempotent f i})

/-- A finite projective module realizing a locally constant stalk-rank function. -/
@[expose] noncomputable def ofLocallyConstantRank (R : Type u) [CommRing R]
    (f : LocallyConstant (PrimeSpectrum R) ℕ) : ModuleCat.FiniteProjective R := by
  let _ : Module.Finite R (rankModule R f) := rankModuleFinite f
  let _ : Module.Projective R (rankModule R f) := rankModuleProjective f
  exact ModuleCat.FiniteProjective.of R (rankModule R f)

/-- The complementary finite projective module in the finite-free realization
of a locally constant stalk-rank function. -/
noncomputable def complementOfLocallyConstantRank (R : Type u) [CommRing R]
    (f : LocallyConstant (PrimeSpectrum R) ℕ) : ModuleCat.FiniteProjective R := by
  let _ : Module.Finite R (rankComplement R f) := rankComplementFinite f
  let _ : Module.Projective R (rankComplement R f) := rankComplementProjective f
  exact ModuleCat.FiniteProjective.of R (rankComplement R f)

private def piProdEquiv (R : Type u) [CommRing R] {I : Type*}
    (A B : I → Type u) [∀ i, AddCommGroup (A i)] [∀ i, Module R (A i)]
    [∀ i, AddCommGroup (B i)] [∀ i, Module R (B i)] :
    ((∀ i, A i) × (∀ i, B i)) ≃ₗ[R] ∀ i, A i × B i where
  toFun x i := (x.1 i, x.2 i)
  invFun x := (fun i ↦ (x i).1, fun i ↦ (x i).2)
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- The realizing module and its componentwise complement sum to a finite
standard free module. -/
noncomputable def prodComplementEquiv (R : Type u) [CommRing R]
    (f : LocallyConstant (PrimeSpectrum R) ℕ) :
    (ofLocallyConstantRank R f × complementOfLocallyConstantRank R f) ≃ₗ[R]
        (Fin (rankBound f) → R) := by
  change (rankModule R f × rankComplement R f) ≃ₗ[R] (Fin (rankBound f) → R)
  exact (piProdEquiv R
      (fun i : Fin (rankBound f) ↦ Ideal.span {rankIdempotent f i})
      (fun i : Fin (rankBound f) ↦ Ideal.span {1 - rankIdempotent f i})).trans
    (LinearEquiv.piCongrRight fun i ↦
      (rankIdempotent_isIdempotent f i).spanProdEquiv)

/-- The module constructed by `ofLocallyConstantRank` has the prescribed
stalk-rank function at every prime. -/
theorem rankAtStalk_ofLocallyConstantRank
    (f : LocallyConstant (PrimeSpectrum R) ℕ) :
    Module.rankAtStalk (R := R) (ofLocallyConstantRank R f) = f := by
  classical
  ext p
  change Module.rankAtStalk (rankModule R f) p = f p
  let _ (i : Fin (rankBound f)) : Module.Finite R (Ideal.span {rankIdempotent f i}) :=
    Module.Finite.span_singleton R _
  let _ (i : Fin (rankBound f)) : Module.Projective R (Ideal.span {rankIdempotent f i}) :=
    (rankIdempotent_isIdempotent f i).projective_span
  rw [Module.rankAtStalk_pi, finsum_eq_sum_of_fintype]
  calc
    (∑ i : Fin (rankBound f),
        Module.rankAtStalk (R := R) (Ideal.span {rankIdempotent f i}) p) =
        ∑ i : Fin (rankBound f), if i.1 < f p then 1 else 0 := by
      apply Finset.sum_congr rfl
      intro i _
      by_cases hi : i.1 < f p
      · rw [ite_eq_left hi]
        exact (rankIdempotent_isIdempotent f i).rankAtStalk_span_eq_one p
          ((rankIdempotent_notMem_iff f i p).2 hi)
      · rw [ite_eq_right hi]
        apply (rankIdempotent_isIdempotent f i).rankAtStalk_span_eq_zero p
        by_contra hmem
        exact hi ((rankIdempotent_notMem_iff f i p).1 hmem)
    _ = f p := by
      rw [← Finset.card_filter, Fin.card_filter_val_lt,
        Nat.min_eq_right (le_rankBound f p)]

end ModuleCat.FiniteProjective
