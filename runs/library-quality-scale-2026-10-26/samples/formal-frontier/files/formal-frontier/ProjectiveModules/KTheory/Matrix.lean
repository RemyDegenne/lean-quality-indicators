module

public import ProjectiveModules.KTheory.ModuleEquivalence
public import ProjectiveModules.KTheory.Rank
public import ProjectiveModules.Module.ProjectivePi
public import ProjectiveModules.Module.RightRegular
public import Mathlib.RingTheory.Morita.Matrix
public import Mathlib.LinearAlgebra.Matrix.Action
public import Mathlib.Algebra.Group.Subgroup.ZPowers.Lemmas
public import Mathlib.Data.ZMod.QuotientGroup

/-!
# Right-module classes and K₀ of matrix rings

The constructions use Mathlib's matrix equivalence over the opposite coefficient
ring, followed by restriction along the inverse transpose/opposite ring
isomorphism. The choice equations include index and supported-height
independence. Direct rows accept arbitrary carrier universes, while inverse
corner evaluation uses a supported category height. The regular matrix module
has inverse class `[ι → R]`, not in general `[R]`.

For division-ring coefficients, inverse Morita equivalence followed by dimension
gives an integer coordinate. The regular matrix class has coordinate
`Fintype.card ι`, and scalar-matrix extension acts on the whole K₀ group by
multiplication by that cardinal. Its range is the cyclic subgroup generated by
the regular class, with that index; for cardinal greater than one the map has
no additive left inverse. This is the normalized Morita/dimension coordinate,
not an identification with intrinsic matrix-module length. Nonempty indices
are essential: an empty matrix ring is a zero ring, whose K₀ is trivial.

## References and credits

* Yunzhou Xie and Jujian Zhang's Mathlib matrix-Morita equivalence.
* Mathlib's matrix module, transpose/opposite ring equivalence and restriction
  of scalars.
* Projective Modules' right-module class and K₀ equivalence interfaces.
* Charles A. Weibel, *The K-book*, Chapter II: finite-projective right modules
  and their additive group completion.

See `docs/MatrixK0Design.md` for the construction and API.
-/

@[expose] public section

open CategoryTheory

universe u v w

variable (R : Type u) [Ring R] (ι : Type v) [Fintype ι] [DecidableEq ι]

namespace ModuleCat

/-- The right-row functor: Mathlib's matrix functor on opposite coefficients,
then scalar pullback along the inverse transpose/opposite ring isomorphism.
No coordinate choice or carrier-height bound is needed for this functor. -/
noncomputable def toRightMatrixModCat :
    ModuleCat.{w} Rᵐᵒᵖ ⥤ ModuleCat.{max v w} (Matrix ι ι R)ᵐᵒᵖ :=
  ModuleCat.toMatrixModCat Rᵐᵒᵖ ι ⋙
    ModuleCat.restrictScalars
      (RingEquiv.mopMatrix :
        Matrix ι ι Rᵐᵒᵖ ≃+* (Matrix ι ι R)ᵐᵒᵖ).symm.toRingHom

/-- The direct row has the coordinate carrier, without repr or ULift. -/
theorem toRightMatrixModCat_obj_carrier (M : ModuleCat.{w} Rᵐᵒᵖ) :
    ((toRightMatrixModCat R ι).obj M : Type (max v w)) = (ι → M) := by
  rfl

/-- Opposite matrix scalars act on the right; for the regular carrier this is
`x * A`, with entries in the displayed noncommutative order. -/
theorem toRightMatrixModCat_smul_apply (M : ModuleCat.{w} Rᵐᵒᵖ)
    (A : Matrix ι ι R) (x : (toRightMatrixModCat R ι).obj M) (j : ι) :
    (MulOpposite.op A • x) j = ∑ k, MulOpposite.op (A k j) • x k := by
  exact Matrix.Module.smul_apply (M := M) (A.transpose.map MulOpposite.op) x j

/-- The direct right row of the regular coefficient module is linearly
equivalent to the canonical matrix row with the vector-matrix action.
Both maps are the identity on row coordinates. -/
noncomputable def toRightMatrixModCatRegularLinearEquiv :
    (toRightMatrixModCat R ι).obj (ModuleCat.of Rᵐᵒᵖ R) ≃ₗ[(Matrix ι ι R)ᵐᵒᵖ] (ι → R) where
  toFun := id
  invFun := id
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' A x := by
    obtain ⟨A, rfl⟩ := MulOpposite.op_surjective A
    funext j
    change (MulOpposite.op A • x) j = (Matrix.vecMul x A) j
    exact toRightMatrixModCat_smul_apply R ι (ModuleCat.of Rᵐᵒᵖ R) A x j

/-- The regular-row comparison preserves every coordinate. -/
@[simp]
theorem toRightMatrixModCatRegularLinearEquiv_apply
    (x : (toRightMatrixModCat R ι).obj (ModuleCat.of Rᵐᵒᵖ R)) :
    toRightMatrixModCatRegularLinearEquiv R ι x = x := rfl

/-- The inverse regular-row comparison preserves every coordinate. -/
@[simp]
theorem toRightMatrixModCatRegularLinearEquiv_symm_apply (x : ι → R) :
    (toRightMatrixModCatRegularLinearEquiv R ι).symm x = x := rfl

/-- The existing functorial map is coordinatewise application of the input map. -/
theorem toRightMatrixModCat_map_apply {M N : ModuleCat.{w} Rᵐᵒᵖ}
    (f : M ⟶ N) (x : (toRightMatrixModCat R ι).obj M) (j : ι) :
    ((toRightMatrixModCat R ι).map f x) j = f (x j) := by
  rfl

/-- An elementary matrix moves one coordinate of a right row to another,
with the coefficient acting on the right. -/
theorem toRightMatrixModCat_single_smul (M : ModuleCat.{w} Rᵐᵒᵖ)
    (i j : ι) (r : R) (x : (toRightMatrixModCat R ι).obj M) :
    MulOpposite.op (Matrix.single i j r) • x =
      Pi.single j (MulOpposite.op r • x i) := by
  funext k
  calc
    (MulOpposite.op (Matrix.single i j r) • x) k =
        ∑ l, MulOpposite.op ((Matrix.single i j r) l k) • x l :=
      toRightMatrixModCat_smul_apply R ι M (Matrix.single i j r) x k
    _ = ∑ l, (Matrix.single j i (MulOpposite.op r)) k l • x l := by
      apply Finset.sum_congr rfl
      intro l _
      congr 1
      by_cases hi : i = l <;> by_cases hj : j = k <;>
        simp [hi, hj]
    _ = (Pi.single j (MulOpposite.op r • x i) : ι → M) k := by
      have h :
          (fun k : ι ↦ ∑ l : ι,
            (Matrix.single j i (MulOpposite.op r) : Matrix ι ι Rᵐᵒᵖ) k l •
              (x l : M)) =
            @Pi.single ι (fun _ : ι ↦ (M : Type w))
              (fun _ : ι ↦ (inferInstance : Zero (M : Type w)))
              (inferInstance : DecidableEq ι) j (MulOpposite.op r • x i) :=
        @Matrix.Module.single_smul ι Rᵐᵒᵖ (M : Type w)
          (inferInstance : Ring Rᵐᵒᵖ) (inferInstance : Fintype ι)
          (inferInstance : DecidableEq ι) M.isAddCommGroup M.isModule
          j i (MulOpposite.op r) (x : ι → M)
      exact congrArg (fun y : ι → (M : Type w) ↦ y k) h

/-- Morphisms of right rows commute with elementary-matrix coordinate transfers. -/
theorem toRightMatrixModCat_hom_single_smul {M N : ModuleCat.{w} Rᵐᵒᵖ}
    (f : (toRightMatrixModCat R ι).obj M ⟶ (toRightMatrixModCat R ι).obj N)
    (i j : ι) (r : R) (x : (toRightMatrixModCat R ι).obj M) :
    f (Pi.single j (MulOpposite.op r • x i)) =
      Pi.single j (MulOpposite.op r • f x i) := by
  exact Eq.trans
    (congrArg
      (fun z : (toRightMatrixModCat R ι).obj M ↦
        (f z : (toRightMatrixModCat R ι).obj N))
      (toRightMatrixModCat_single_smul R ι M i j r x).symm)
    (Eq.trans
      (show (f (MulOpposite.op (Matrix.single i j r) • x) :
          (toRightMatrixModCat R ι).obj N) =
          MulOpposite.op (Matrix.single i j r) •
            (f x : (toRightMatrixModCat R ι).obj N) from
        f.hom.map_smul (MulOpposite.op (Matrix.single i j r)) x)
      (toRightMatrixModCat_single_smul R ι N i j r
        (f x : (toRightMatrixModCat R ι).obj N)))

/-- The right-row functor is fully faithful at arbitrary carrier heights.
Its inverse on morphisms evaluates a row supported at the chosen index. -/
noncomputable def fullyFaithfulToRightMatrixModCat (i : ι) :
    (toRightMatrixModCat.{u, v, w} R ι).FullyFaithful where
  preimage {X Y} f := ModuleCat.ofHom (X := X) (Y := Y)
    ({ toFun := fun x ↦ f (Pi.single i x) i
       map_add' x y := by
         rw [Pi.single_add]
         exact congrFun (f.hom.map_add _ _) i
       map_smul' r x := by
         obtain ⟨r, rfl⟩ := MulOpposite.op_surjective r
         have h := congrFun
           (toRightMatrixModCat_hom_single_smul R ι f i i r
             (Pi.single i x : (toRightMatrixModCat R ι).obj X)) i
         simpa only [Pi.single_eq_same, RingHom.id_apply] using h } : X →ₗ[Rᵐᵒᵖ] Y)
  map_preimage {X Y} f := by
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    funext j
    change f (Pi.single i (x j)) i = f x j
    have h := congrFun (toRightMatrixModCat_hom_single_smul R ι f j i 1 x) i
    simpa only [MulOpposite.op_one, one_smul, Pi.single_eq_same] using h
  preimage_map {X Y} f := by
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    let u : (toRightMatrixModCat R ι).obj X :=
      show (toRightMatrixModCat R ι).obj X from
        @Pi.single ι (fun _ : ι ↦ (X : Type w))
          (fun _ : ι ↦ (inferInstance : Zero (X : Type w)))
          (inferInstance : DecidableEq ι) i x
    have hu : (u i : X) = x :=
      @Pi.single_eq_same ι (fun _ : ι ↦ (X : Type w))
        (fun _ : ι ↦ (inferInstance : Zero (X : Type w)))
        (inferInstance : DecidableEq ι) i x
    change (((toRightMatrixModCat R ι).map f u) i : Y) = (f x : Y)
    exact @Eq.trans (Y : Type w)
      (((toRightMatrixModCat R ι).map f u) i) (f (u i) : Y) (f x : Y)
      (toRightMatrixModCat_map_apply R ι (M := X) (N := Y) f u i)
      (congrArg (fun y : X ↦ (f y : Y)) hu)

/-- The inverse on morphisms evaluates a supported row at the chosen index. -/
@[simp]
theorem fullyFaithfulToRightMatrixModCat_preimage_apply (i : ι)
    {X Y : ModuleCat.{w} Rᵐᵒᵖ}
    (f : (toRightMatrixModCat R ι).obj X ⟶ (toRightMatrixModCat R ι).obj Y) (x : X) :
    (fullyFaithfulToRightMatrixModCat R ι i).preimage f x = f (Pi.single i x) i := rfl

/-- At a common carrier height, the fully faithful right-row functor agrees
with the one supplied by the matrix and restriction-of-scalars equivalences. -/
theorem fullyFaithfulToRightMatrixModCat_eq (i : ι) :
    let e : ModuleCat.{max (max u v) w} Rᵐᵒᵖ ≌
        ModuleCat.{max (max u v) w} (Matrix ι ι R)ᵐᵒᵖ :=
      (ModuleCat.matrixEquivalence.{u, v, max u w} Rᵐᵒᵖ i).trans
        (ModuleCat.restrictScalarsEquivalenceOfRingEquiv
          (RingEquiv.mopMatrix :
            Matrix ι ι Rᵐᵒᵖ ≃+* (Matrix ι ι R)ᵐᵒᵖ).symm)
    fullyFaithfulToRightMatrixModCat.{u, v, max (max u v) w} R ι i =
      e.fullyFaithfulFunctor := by
  exact Subsingleton.elim _ _

/-- The right-row functor identifies endomorphism rings at arbitrary carrier
heights. The chosen matrix index is used only for its inverse. -/
noncomputable def toRightMatrixModCatEndEquiv (i : ι) (M : ModuleCat.{w} Rᵐᵒᵖ) :
    Module.End Rᵐᵒᵖ M ≃+*
      Module.End (Matrix ι ι R)ᵐᵒᵖ ((toRightMatrixModCat R ι).obj M) := by
  let g : CategoryTheory.End M ≃+*
      CategoryTheory.End ((toRightMatrixModCat R ι).obj M) :=
    { __ := (fullyFaithfulToRightMatrixModCat R ι i).mulEquivEnd M
      map_add' := fun _ _ ↦ rfl }
  exact (ModuleCat.endRingEquiv M).symm.trans
    (g.trans (ModuleCat.endRingEquiv ((toRightMatrixModCat R ι).obj M)))

/-- The endomorphism correspondence applies the original endomorphism in every
row coordinate. -/
@[simp]
theorem toRightMatrixModCatEndEquiv_apply (i : ι)
    (M : ModuleCat.{w} Rᵐᵒᵖ) (f : Module.End Rᵐᵒᵖ M)
    (x : (toRightMatrixModCat R ι).obj M) (j : ι) :
    toRightMatrixModCatEndEquiv R ι i M f x j = f (x j) := rfl

/-- The inverse endomorphism correspondence evaluates a row supported at the
chosen index and then takes that coordinate. -/
@[simp]
theorem toRightMatrixModCatEndEquiv_symm_apply (i : ι)
    (M : ModuleCat.{w} Rᵐᵒᵖ)
    (f : Module.End (Matrix ι ι R)ᵐᵒᵖ ((toRightMatrixModCat R ι).obj M)) (m : M) :
    (toRightMatrixModCatEndEquiv R ι i M).symm f m = f (Pi.single i m) i := by
  calc
    (toRightMatrixModCatEndEquiv R ι i M).symm f m =
        toRightMatrixModCatEndEquiv R ι i M
          ((toRightMatrixModCatEndEquiv R ι i M).symm f) (Pi.single i m) i := by
      simpa only [Pi.single_eq_same] using
        (toRightMatrixModCatEndEquiv_apply R ι i M
          ((toRightMatrixModCatEndEquiv R ι i M).symm f) (Pi.single i m) i).symm
    _ = f (Pi.single i m) i :=
      congrFun (LinearMap.congr_fun
        ((toRightMatrixModCatEndEquiv R ι i M).apply_symm_apply f) (Pi.single i m)) i

section

universe w'

-- A linear equivalence acts coordinatewise on rows, including across carrier heights.
private noncomputable def rightMatrixCongr
    {M : Type w} [AddCommGroup M] [Module Rᵐᵒᵖ M]
    {N : Type w'} [AddCommGroup N] [Module Rᵐᵒᵖ N] (e : M ≃ₗ[Rᵐᵒᵖ] N) :
    (ModuleCat.toRightMatrixModCat R ι).obj (ModuleCat.of Rᵐᵒᵖ M) ≃ₗ[(Matrix ι ι R)ᵐᵒᵖ]
      (ModuleCat.toRightMatrixModCat R ι).obj (ModuleCat.of Rᵐᵒᵖ N) where
  toFun x j := e (x j)
  invFun x j := e.symm (x j)
  left_inv x := by funext j; exact e.symm_apply_apply (x j)
  right_inv x := by funext j; exact e.apply_symm_apply (x j)
  map_add' x y := by funext j; exact e.map_add (x j) (y j)
  map_smul' A x := by
    obtain ⟨A, rfl⟩ := MulOpposite.op_surjective A
    funext j
    simp only [RingHom.id_apply]
    change e ((MulOpposite.op A • x) j) =
      ∑ k, MulOpposite.op (A k j) • e (x k)
    simp only [ModuleCat.toRightMatrixModCat_smul_apply, map_sum, map_smul]

end

/-- Direct rows of finite projectives are finite projective at arbitrary carrier
heights, including for an empty index. This is not a global action instance. -/
theorem isFiniteProjective_toRightMatrixModCat_obj (M : ModuleCat.{w} Rᵐᵒᵖ)
    (hM : isFiniteProjective Rᵐᵒᵖ M) :
    isFiniteProjective (Matrix ι ι R)ᵐᵒᵖ ((toRightMatrixModCat R ι).obj M) := by
  classical
  rcases isEmpty_or_nonempty ι with hι | hι
  · -- Empty rows are the zero module, so no coordinate needs to be chosen.
    let : IsEmpty ι := hι
    let : Subsingleton ((toRightMatrixModCat R ι).obj M) :=
      inferInstanceAs (Subsingleton (ι → M))
    exact ⟨inferInstance, inferInstance⟩
  · -- Apply categorical preservation only at a height containing both rings,
    -- then lower the coordinates by a cross-universe linear equivalence.
    let : Module.Finite Rᵐᵒᵖ M := hM.1
    let : Module.Projective Rᵐᵒᵖ M := hM.2
    let X : ModuleCat.{max (max u v) w} Rᵐᵒᵖ :=
      ModuleCat.of Rᵐᵒᵖ (ULift.{max u v} M)
    let e : ModuleCat.{max (max u v) w} Rᵐᵒᵖ ≌
        ModuleCat.{max (max u v) w} (Matrix ι ι R)ᵐᵒᵖ :=
      (ModuleCat.matrixEquivalence.{u, v, max u w} Rᵐᵒᵖ (Classical.choice hι)).trans
        (ModuleCat.restrictScalarsEquivalenceOfRingEquiv
          (RingEquiv.mopMatrix :
            Matrix ι ι Rᵐᵒᵖ ≃+* (Matrix ι ι R)ᵐᵒᵖ).symm)
    have hX : isFiniteProjective Rᵐᵒᵖ X := ⟨inferInstance, inferInstance⟩
    have hY := isFiniteProjective_of_equivalence.{u, max u v, max (max u v) w, w}
      Rᵐᵒᵖ (Matrix ι ι R)ᵐᵒᵖ e X hX
    let : Module.Finite (Matrix ι ι R)ᵐᵒᵖ ((toRightMatrixModCat R ι).obj X) := hY.1
    let : Module.Projective (Matrix ι ι R)ᵐᵒᵖ ((toRightMatrixModCat R ι).obj X) := hY.2
    let f := rightMatrixCongr R ι
      (ULift.moduleEquiv : ULift.{max u v} M ≃ₗ[Rᵐᵒᵖ] M)
    exact ⟨Module.Finite.equiv f, Module.Projective.of_equiv' f⟩

end ModuleCat

namespace KTheory

variable [Nonempty ι]

namespace ProjectiveClass

universe w'

-- Compare the generic representative/ULift image with the direct row. Both the
-- category height and the input carrier height are independent parameters.
omit [Nonempty ι] in
private theorem matrixImage_of_module (i : ι) (M : Type w')
    [AddCommGroup M] [Module Rᵐᵒᵖ M]
    [Module.Finite Rᵐᵒᵖ M] [Module.Projective Rᵐᵒᵖ M] :
    let e : ModuleCat.{max (max u v) w} Rᵐᵒᵖ ≌
        ModuleCat.{max (max u v) w} (Matrix ι ι R)ᵐᵒᵖ :=
      (ModuleCat.matrixEquivalence.{u, v, max u w} Rᵐᵒᵖ i).trans
        (ModuleCat.restrictScalarsEquivalenceOfRingEquiv
          (RingEquiv.mopMatrix :
            Matrix ι ι Rᵐᵒᵖ ≃+* (Matrix ι ι R)ᵐᵒᵖ).symm)
    let X := ModuleCat.of Rᵐᵒᵖ M
    let Y := (ModuleCat.toRightMatrixModCat R ι).obj X
    let h := ModuleCat.isFiniteProjective_toRightMatrixModCat_obj R ι X
      ⟨inferInstance, inferInstance⟩
    equivOfModuleEquivalence.{u, max u v, max v w, w} e (of R M) =
      @of (Matrix ι ι R) _ Y _ _ h.1 h.2 := by
  let e : ModuleCat.{max (max u v) w} Rᵐᵒᵖ ≌
      ModuleCat.{max (max u v) w} (Matrix ι ι R)ᵐᵒᵖ :=
    (ModuleCat.matrixEquivalence.{u, v, max u w} Rᵐᵒᵖ i).trans
      (ModuleCat.restrictScalarsEquivalenceOfRingEquiv
        (RingEquiv.mopMatrix :
          Matrix ι ι Rᵐᵒᵖ ≃+* (Matrix ι ι R)ᵐᵒᵖ).symm)
  let L := ULift.{max v w} (ModuleCat.FiniteProjective.repr Rᵐᵒᵖ M)
  let Z := (ModuleCat.toRightMatrixModCat R ι).obj (ModuleCat.of Rᵐᵒᵖ L)
  let Y := (ModuleCat.toRightMatrixModCat R ι).obj (ModuleCat.of Rᵐᵒᵖ M)
  have hZ := ModuleCat.isFiniteProjective_toRightMatrixModCat_obj R ι
    (ModuleCat.of Rᵐᵒᵖ L) ⟨inferInstance, inferInstance⟩
  have hY := ModuleCat.isFiniteProjective_toRightMatrixModCat_obj R ι
    (ModuleCat.of Rᵐᵒᵖ M) ⟨inferInstance, inferInstance⟩
  let : Module.Finite (Matrix ι ι R)ᵐᵒᵖ Z := hZ.1
  let : Module.Projective (Matrix ι ι R)ᵐᵒᵖ Z := hZ.2
  let : Module.Finite (Matrix ι ι R)ᵐᵒᵖ Y := hY.1
  let : Module.Projective (Matrix ι ι R)ᵐᵒᵖ Y := hY.2
  change equivOfModuleEquivalence.{u, max u v, max v w, w} e (of R M) = of _ Y
  calc
    equivOfModuleEquivalence.{u, max u v, max v w, w} e (of R M) = of _ Z :=
      equivOfModuleEquivalence_of_module.{u, max u v, max v w, w, w'} e M
    _ = of _ Y := of_eq_of_equiv (Matrix ι ι R) Z
      (ModuleCat.rightMatrixCongr R ι (ULift.moduleEquiv.trans
        (ModuleCat.FiniteProjective.reprEquiv Rᵐᵒᵖ M)))

/-- The matrix-ring additive equivalence on finite-projective right-module
classes, as in Weibel's *The K-book*, Chapter II. The construction chooses an
index; `matrixEquiv_eq_of_index` specifies independence from that index and
from supported carrier lifts. -/
noncomputable def matrixEquiv : ProjectiveClass R ≃+ ProjectiveClass (Matrix ι ι R) :=
  equivOfModuleEquivalence.{u, max u v, v, 0}
    (show ModuleCat.{max u v} Rᵐᵒᵖ ≌
        ModuleCat.{max u v} (Matrix ι ι R)ᵐᵒᵖ from
      (ModuleCat.matrixEquivalence.{u, v, u} Rᵐᵒᵖ (Classical.arbitrary ι)).trans
        (ModuleCat.restrictScalarsEquivalenceOfRingEquiv
          (RingEquiv.mopMatrix :
            Matrix ι ι Rᵐᵒᵖ ≃+* (Matrix ι ι R)ᵐᵒᵖ).symm))

/-- Every chosen coordinate, at every supported common height, gives the same
whole class equivalence. No equality of the inverse functors is assumed. -/
theorem matrixEquiv_eq_of_index (i : ι) :
    let e : ModuleCat.{max (max u v) w} Rᵐᵒᵖ ≌
        ModuleCat.{max (max u v) w} (Matrix ι ι R)ᵐᵒᵖ :=
      (ModuleCat.matrixEquivalence.{u, v, max u w} Rᵐᵒᵖ i).trans
        (ModuleCat.restrictScalarsEquivalenceOfRingEquiv
          (RingEquiv.mopMatrix :
            Matrix ι ι Rᵐᵒᵖ ≃+* (Matrix ι ι R)ᵐᵒᵖ).symm)
    matrixEquiv R ι = equivOfModuleEquivalence.{u, max u v, max v w, w} e := by
  apply AddEquiv.ext
  intro a
  refine induction_on R a ?_
  intro X
  exact (matrixImage_of_module.{u, v, 0, u} R ι (Classical.arbitrary ι) X).trans
    (matrixImage_of_module.{u, v, w, u} R ι i X).symm

/-- An arbitrary finite-projective right module goes to its direct right row.
The explicit evidence avoids a global instance on functor images. -/
theorem matrixEquiv_of_module (M : Type w) [AddCommGroup M] [Module Rᵐᵒᵖ M]
    [Module.Finite Rᵐᵒᵖ M] [Module.Projective Rᵐᵒᵖ M] :
    let X := ModuleCat.of Rᵐᵒᵖ M
    let Y := (ModuleCat.toRightMatrixModCat R ι).obj X
    let h := ModuleCat.isFiniteProjective_toRightMatrixModCat_obj R ι X
      ⟨inferInstance, inferInstance⟩
    matrixEquiv R ι (of R M) = @of (Matrix ι ι R) _ Y _ _ h.1 h.2 := by
  exact matrixImage_of_module.{u, v, 0, w} R ι (Classical.arbitrary ι) M

/-- Inverse evaluation on a supported matrix module is its chosen corner,
the range of `op (Eᵢᵢ)` with Mathlib's scalar-diagonal `Rᵐᵒᵖ` action. -/
theorem matrixEquiv_symm_of (i : ι)
    (Y : ModuleCat.FiniteProjective.{max u v, max (max u v) w}
      (Matrix ι ι R)ᵐᵒᵖ) :
    let e : ModuleCat.{max (max u v) w} Rᵐᵒᵖ ≌
        ModuleCat.{max (max u v) w} (Matrix ι ι R)ᵐᵒᵖ :=
      (ModuleCat.matrixEquivalence.{u, v, max u w} Rᵐᵒᵖ i).trans
        (ModuleCat.restrictScalarsEquivalenceOfRingEquiv
          (RingEquiv.mopMatrix :
            Matrix ι ι Rᵐᵒᵖ ≃+* (Matrix ι ι R)ᵐᵒᵖ).symm)
    let h := ModuleCat.isFiniteProjective_of_equivalence.{max u v, u,
      max (max u v) w, max v w}
      (Matrix ι ι R)ᵐᵒᵖ Rᵐᵒᵖ e.symm Y.obj Y.property
    (matrixEquiv R ι).symm (of (Matrix ι ι R) Y) =
      @of R _ (e.inverse.obj Y.obj) _ _ h.1 h.2 := by
  dsimp only
  rw [matrixEquiv_eq_of_index.{u, v, w} R ι i]
  exact equivOfModuleEquivalence_symm_of.{u, max u v, max v w, w} _ Y

/-- The inverse of the regular matrix class is the pointwise right-regular
coordinate module `ι → R`, obtained by extracting the chosen column of `A * Eᵢᵢ`. -/
theorem matrixEquiv_symm_regular :
    (matrixEquiv R ι).symm (of (Matrix ι ι R) (Matrix ι ι R)) =
      of R (ι → R) := by
  let X := ModuleCat.of Rᵐᵒᵖ (ι → R)
  let Y := (ModuleCat.toRightMatrixModCat R ι).obj X
  have hY := ModuleCat.isFiniteProjective_toRightMatrixModCat_obj R ι X
    ⟨inferInstance, inferInstance⟩
  let : Module.Finite (Matrix ι ι R)ᵐᵒᵖ Y := hY.1
  let : Module.Projective (Matrix ι ι R)ᵐᵒᵖ Y := hY.2
  -- A row of coordinate vectors is a matrix whose j-th column is that vector.
  -- Its row action is exactly ordinary right multiplication, without commuting entries.
  let e : Y ≃ₗ[(Matrix ι ι R)ᵐᵒᵖ] Matrix ι ι R :=
    { toFun := fun x j k => x k j
      invFun := fun A j k => A k j
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_add' := fun _ _ => rfl
      map_smul' := by
        intro A x
        obtain ⟨A, rfl⟩ := MulOpposite.op_surjective A
        funext j k
        let p : X →ₗ[Rᵐᵒᵖ] R := LinearMap.proj j
        change p ((MulOpposite.op A • x) k) = ∑ l, p (x l) * A l k
        calc
          p ((MulOpposite.op A • x) k) =
              p (∑ l, MulOpposite.op (A l k) • x l) :=
            congrArg p (ModuleCat.toRightMatrixModCat_smul_apply R ι X A x k)
          _ = ∑ l, p (MulOpposite.op (A l k) • x l) := map_sum p _ _
          _ = ∑ l, MulOpposite.op (A l k) • p (x l) :=
            Finset.sum_congr rfl fun l _ => p.map_smul (MulOpposite.op (A l k)) (x l)
          _ = ∑ l, p (x l) * A l k :=
            Finset.sum_congr rfl fun l _ => op_smul_eq_mul (A l k) (p (x l)) }
  apply (matrixEquiv R ι).injective
  rw [AddEquiv.apply_symm_apply]
  exact (of_eq_of_equiv (Matrix ι ι R) Y e).symm.trans
    (matrixEquiv_of_module R ι (ι → R)).symm

end ProjectiveClass

namespace K0

/-- The matrix-ring additive equivalence on K₀ for a finite nonempty index,
as in Weibel's *The K-book*, Chapter II, using the existing group completion. -/
noncomputable def matrixEquiv : K0 R ≃+ K0 (Matrix ι ι R) :=
  equivOfModuleEquivalence.{u, max u v, v, 0}
    (show ModuleCat.{max u v} Rᵐᵒᵖ ≌
        ModuleCat.{max u v} (Matrix ι ι R)ᵐᵒᵖ from
      (ModuleCat.matrixEquivalence.{u, v, u} Rᵐᵒᵖ (Classical.arbitrary ι)).trans
        (ModuleCat.restrictScalarsEquivalenceOfRingEquiv
          (RingEquiv.mopMatrix :
            Matrix ι ι Rᵐᵒᵖ ≃+* (Matrix ι ι R)ᵐᵒᵖ).symm))

/-- The canonical class-to-completion square commutes as a whole additive hom. -/
theorem matrixEquiv_comp_ofClass :
    (matrixEquiv R ι).toAddMonoidHom.comp (ofClass R) =
      (ofClass (Matrix ι ι R)).comp
        (ProjectiveClass.matrixEquiv R ι).toAddMonoidHom := by
  apply AddMonoidHom.ext
  intro a
  exact equivOfModuleEquivalence_ofClass.{u, max u v, v, 0}
    ((ModuleCat.matrixEquivalence.{u, v, u} Rᵐᵒᵖ (Classical.arbitrary ι)).trans
      (ModuleCat.restrictScalarsEquivalenceOfRingEquiv
        (RingEquiv.mopMatrix :
          Matrix ι ι Rᵐᵒᵖ ≃+* (Matrix ι ι R)ᵐᵒᵖ).symm)) a

/-- Inverse Morita equivalence commutes with the canonical class-to-K₀ map. -/
theorem matrixEquiv_symm_ofClass (a : ProjectiveClass (Matrix ι ι R)) :
    (matrixEquiv R ι).symm (ofClass (Matrix ι ι R) a) =
      ofClass R ((ProjectiveClass.matrixEquiv R ι).symm a) := by
  apply (matrixEquiv R ι).injective
  rw [AddEquiv.apply_symm_apply]
  have h := DFunLike.congr_fun (matrixEquiv_comp_ofClass R ι)
    ((ProjectiveClass.matrixEquiv R ι).symm a)
  simpa only [AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom,
    AddEquiv.apply_symm_apply] using h.symm

/-- The K₀ equivalence is independent of the chosen index and supported height. -/
theorem matrixEquiv_eq_of_index (i : ι) :
    let e : ModuleCat.{max (max u v) w} Rᵐᵒᵖ ≌
        ModuleCat.{max (max u v) w} (Matrix ι ι R)ᵐᵒᵖ :=
      (ModuleCat.matrixEquivalence.{u, v, max u w} Rᵐᵒᵖ i).trans
        (ModuleCat.restrictScalarsEquivalenceOfRingEquiv
          (RingEquiv.mopMatrix :
            Matrix ι ι Rᵐᵒᵖ ≃+* (Matrix ι ι R)ᵐᵒᵖ).symm)
    matrixEquiv R ι = equivOfModuleEquivalence.{u, max u v, max v w, w} e := by
  dsimp only
  apply AddEquiv.toAddMonoidHom_injective
  apply hom_ext_ofClass R
  intro a
  simpa only [AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom,
    equivOfModuleEquivalence_ofClass,
    ProjectiveClass.matrixEquiv_eq_of_index.{u, v, w} R ι i] using
      DFunLike.congr_fun (matrixEquiv_comp_ofClass R ι) a

/-- Arbitrary-carrier K₀ generators evaluate on the direct right row. -/
theorem matrixEquiv_of_module (M : Type w) [AddCommGroup M] [Module Rᵐᵒᵖ M]
    [Module.Finite Rᵐᵒᵖ M] [Module.Projective Rᵐᵒᵖ M] :
    let X := ModuleCat.of Rᵐᵒᵖ M
    let Y := (ModuleCat.toRightMatrixModCat R ι).obj X
    let h := ModuleCat.isFiniteProjective_toRightMatrixModCat_obj R ι X
      ⟨inferInstance, inferInstance⟩
    matrixEquiv R ι (of R M) = @of (Matrix ι ι R) _ Y _ _ h.1 h.2 := by
  dsimp only
  calc
    matrixEquiv R ι (of R M) =
        ofClass (Matrix ι ι R) (ProjectiveClass.matrixEquiv R ι
          (ProjectiveClass.of R M)) :=
      DFunLike.congr_fun (matrixEquiv_comp_ofClass R ι) (ProjectiveClass.of R M)
    _ = _ := congrArg (ofClass (Matrix ι ι R))
      (ProjectiveClass.matrixEquiv_of_module R ι M)

/-- Inverse K₀ generator evaluation uses the supported chosen-corner image. -/
theorem matrixEquiv_symm_of (i : ι)
    (Y : ModuleCat.FiniteProjective.{max u v, max (max u v) w}
      (Matrix ι ι R)ᵐᵒᵖ) :
    let e : ModuleCat.{max (max u v) w} Rᵐᵒᵖ ≌
        ModuleCat.{max (max u v) w} (Matrix ι ι R)ᵐᵒᵖ :=
      (ModuleCat.matrixEquivalence.{u, v, max u w} Rᵐᵒᵖ i).trans
        (ModuleCat.restrictScalarsEquivalenceOfRingEquiv
          (RingEquiv.mopMatrix :
            Matrix ι ι Rᵐᵒᵖ ≃+* (Matrix ι ι R)ᵐᵒᵖ).symm)
    let h := ModuleCat.isFiniteProjective_of_equivalence.{max u v, u,
      max (max u v) w, max v w}
      (Matrix ι ι R)ᵐᵒᵖ Rᵐᵒᵖ e.symm Y.obj Y.property
    (matrixEquiv R ι).symm (of (Matrix ι ι R) Y) =
      @of R _ (e.inverse.obj Y.obj) _ _ h.1 h.2 := by
  dsimp only
  rw [matrixEquiv_eq_of_index.{u, v, w} R ι i]
  exact equivOfModuleEquivalence_symm_of.{u, max u v, max v w, w} _ Y

/-- Inverse regular-generator normalization needs neither IBN nor injectivity
of the class-to-K₀ map. The coordinate action is the canonical `Rᵐᵒᵖ` Pi action. -/
theorem matrixEquiv_symm_regular :
    (matrixEquiv R ι).symm (of (Matrix ι ι R) (Matrix ι ι R)) =
      of R (ι → R) := by
  apply (matrixEquiv R ι).injective
  rw [AddEquiv.apply_symm_apply]
  -- Evaluate the whole completion square at the inverse regular class.
  -- Only the additive equivalence is cancelled, not the class-to-K₀ map.
  have h := DFunLike.congr_fun (matrixEquiv_comp_ofClass R ι)
    ((ProjectiveClass.matrixEquiv R ι).symm
      (ProjectiveClass.of (Matrix ι ι R) (Matrix ι ι R)))
  simp only [AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom] at h
  -- Cancel the outer class round trip before normalizing the inverse class.
  rw [AddEquiv.apply_symm_apply] at h
  simpa only [ProjectiveClass.matrixEquiv_symm_regular, ofClass_of] using h.symm

end K0

end KTheory

universe uD uι

namespace KTheory

section DivisionMatrix

variable (D : Type uD) [DivisionRing D]
variable (κ : Type uι) [Fintype κ] [DecidableEq κ]

namespace ProjectiveClass

/-- The normalized Morita/dimension coordinate of the scalar-self regular
matrix class is the size of the matrix index. -/
theorem finrankEquiv_matrixEquiv_symm_regular [Nonempty κ] :
    ((matrixEquiv D κ).symm.trans (finrankEquiv D))
        (of (Matrix κ κ D) (Matrix κ κ D)ᵐᵒᵖ) = Fintype.card κ := by
  have hregular : of (Matrix κ κ D) (Matrix κ κ D)ᵐᵒᵖ =
      of (Matrix κ κ D) (Matrix κ κ D) :=
    (of_eq_of_equiv (Matrix κ κ D) (Matrix κ κ D)
      (MulOpposite.opLinearEquiv (Matrix κ κ D)ᵐᵒᵖ)).symm
  rw [hregular, AddEquiv.trans_apply, matrixEquiv_symm_regular,
    finrankEquiv_of_module]
  exact (Module.rightFreeCoordEquiv D κ).symm.finrank_eq.trans
    (Module.finrank_fintype_fun_eq_card (R := Dᵐᵒᵖ))

end ProjectiveClass

namespace K0

/-- The integer normalized matrix coordinate of a class generator is the
natural normalized class coordinate, cast to the integers. -/
theorem finrankEquiv_matrixEquiv_symm_ofClass [Nonempty κ]
    (a : ProjectiveClass (Matrix κ κ D)) :
    ((matrixEquiv D κ).symm.trans (finrankEquiv D))
        (ofClass (Matrix κ κ D) a) =
      (((ProjectiveClass.matrixEquiv D κ).symm.trans
        (ProjectiveClass.finrankEquiv D)) a : ℤ) := by
  simp only [AddEquiv.trans_apply, matrixEquiv_symm_ofClass, finrankEquiv_ofClass]

/-- The regular right-module K₀ generator of a matrix ring has normalized
Morita/dimension coordinate equal to the matrix size. -/
theorem finrankEquiv_matrixEquiv_symm_regular [Nonempty κ] :
    ((matrixEquiv D κ).symm.trans (finrankEquiv D))
        (of (Matrix κ κ D) (Matrix κ κ D)ᵐᵒᵖ) = (Fintype.card κ : ℤ) := by
  change ((matrixEquiv D κ).symm.trans (finrankEquiv D))
    (ofClass (Matrix κ κ D)
      (ProjectiveClass.of (Matrix κ κ D) (Matrix κ κ D)ᵐᵒᵖ)) = _
  rw [finrankEquiv_matrixEquiv_symm_ofClass,
    ProjectiveClass.finrankEquiv_matrixEquiv_symm_regular]

/-- Under the normalized Morita/dimension coordinate, scalar-matrix extension
on the entire K₀ group is multiplication by the matrix size. The scalar map
is `Matrix.scalar`, valid without commutativity of the division ring.
This compares the canonical ring map with the Morita calculation of Weibel's
*The K-book*, Chapter II, §2. -/
theorem finrankEquiv_matrixEquiv_symm_comp_map_scalar [Nonempty κ] :
    ((matrixEquiv D κ).symm.trans (finrankEquiv D)).toAddMonoidHom.comp
        (map (Matrix.scalar κ : D →+* Matrix κ κ D)) =
      (zmultiplesHom ℤ (Fintype.card κ : ℤ)).comp (finrankHom D) := by
  apply AddMonoidHom.ext
  intro x
  obtain ⟨z, rfl⟩ := (finrankEquiv D).symm.surjective x
  rw [finrankEquiv_symm_apply]
  simp only [AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom,
    map_zsmul, map_of_self, finrankEquiv_matrixEquiv_symm_regular,
    finrankHom_of_self, zmultiplesHom_apply, Int.zsmul_eq_mul, one_mul]

/-- The canonical scalar-matrix K₀ map has as its range the cyclic subgroup
generated by the regular right-module class. -/
theorem range_map_matrix_scalar :
    (map (Matrix.scalar κ : D →+* Matrix κ κ D)).range =
      AddSubgroup.zmultiples (of (Matrix κ κ D) (Matrix κ κ D)ᵐᵒᵖ) := by
  ext y
  constructor
  · rintro ⟨x, rfl⟩
    obtain ⟨z, rfl⟩ := (finrankEquiv D).symm.surjective x
    rw [finrankEquiv_symm_apply, map_zsmul, map_of_self]
    exact AddSubgroup.zsmul_mem_zmultiples _ z
  · intro hy
    obtain ⟨z, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp hy
    exact ⟨z • of D Dᵐᵒᵖ, by rw [map_zsmul, map_of_self]⟩

/-- For a finite nonempty matrix ring over a division ring, the subgroup of
integer multiples of the regular class has index equal to the matrix size.
This is the free-class index in Weibel's *The K-book*, Chapter II, §2. -/
theorem index_zmultiples_matrix_regular [Nonempty κ] :
    (AddSubgroup.zmultiples (of (Matrix κ κ D) (Matrix κ κ D)ᵐᵒᵖ)).index =
      Fintype.card κ := by
  have h := AddSubgroup.index_map_equiv
    (AddSubgroup.zmultiples (of (Matrix κ κ D) (Matrix κ κ D)ᵐᵒᵖ))
    ((matrixEquiv D κ).symm.trans (finrankEquiv D))
  rw [AddMonoidHom.map_zmultiples] at h
  simpa only [AddMonoidHom.coe_coe, finrankEquiv_matrixEquiv_symm_regular,
    Int.index_zmultiples, Int.natAbs_natCast] using h.symm

/-- For matrix size greater than one, scalar-matrix extension has no additive
left inverse. This is a statement about the canonical scalar map and the
regular free-class subgroup, not about the Morita equivalence or unbundled
set-theoretic left inverses. -/
theorem not_exists_leftInverse_map_matrix_scalar (hκ : 1 < Fintype.card κ) :
    ¬ ∃ q : K0 (Matrix κ κ D) →+ K0 D,
      q.comp (map (Matrix.scalar κ : D →+* Matrix κ κ D)) =
        AddMonoidHom.id (K0 D) := by
  let : Nonempty κ := Fintype.card_pos_iff.mp (lt_trans Nat.zero_lt_one hκ)
  rintro ⟨q, hq⟩
  let e : K0 (Matrix κ κ D) ≃+ ℤ :=
    (matrixEquiv D κ).symm.trans (finrankEquiv D)
  have he : e (of (Matrix κ κ D) (Matrix κ κ D)ᵐᵒᵖ) =
      (Fintype.card κ : ℤ) := finrankEquiv_matrixEquiv_symm_regular D κ
  have hregular : of (Matrix κ κ D) (Matrix κ κ D)ᵐᵒᵖ =
      Fintype.card κ • e.symm 1 := by
    apply e.injective
    rw [he, map_nsmul, AddEquiv.apply_symm_apply, nsmul_eq_mul, mul_one]
  have hqregular : q (of (Matrix κ κ D) (Matrix κ κ D)ᵐᵒᵖ) =
      of D Dᵐᵒᵖ := by
    simpa only [AddMonoidHom.comp_apply, map_of_self, AddMonoidHom.id_apply] using
      DFunLike.congr_fun hq (of D Dᵐᵒᵖ)
  have hproduct := congrArg (finrankHom D) hqregular
  rw [hregular, map_nsmul, map_nsmul, finrankHom_of_self, nsmul_eq_mul] at hproduct
  have hdiv : (Fintype.card κ : ℤ) ∣ 1 := ⟨_, hproduct.symm⟩
  have hcard : Fintype.card κ = 1 :=
    Nat.dvd_one.mp (Int.natCast_dvd_natCast.mp hdiv)
  exact (ne_of_gt hκ) hcard

end K0

end DivisionMatrix

end KTheory
