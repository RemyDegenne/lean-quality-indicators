public section

open scoped NumberField

open Polynomial RingOfIntegers

namespace TauCeti.NumberField

variable {K : Type*} [Field K] [NumberField K]

/-- A field `K` is **monogenic** when its ring of integers is generated by a single algebraic
integer as a `ℤ`-algebra, that is `𝓞 K = ℤ[θ]`.

Only `[Field K]` is assumed, because `𝓞 K` needs no more than that; the intended case, and the
one every result below is about, is a number field. -/
def IsMonogenic (K : Type*) [Field K] : Prop :=
  ∃ θ : 𝓞 K, Algebra.adjoin ℤ {θ} = ⊤

end TauCeti.NumberField
end
