public section

namespace TauCeti.TypeBSpinCarrier

open CategoryTheory

universe v w

variable (n : ℕ) (A : Type v) [CommRing A]

/-- The defining ideal of the subgroup generated by the numbered root subgroups and the weight
torus of the type-`Bₙ₊₁` spin carrier. -/
noncomputable def generatedDefiningIdeal :
    HopfIdeal A (GeneralLinear.coordinateHopfAlgebra A (dimension n)) :=
  CommHopfAlgCat.commonKernelHopfIdeal (generatorCoordinateMap n A)

end TauCeti.TypeBSpinCarrier
end
