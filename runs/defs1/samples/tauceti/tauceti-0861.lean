public section

namespace TauCeti.TypeDSpinCarrier

open CategoryTheory

universe v w

variable (n : ℕ) (hn : 4 ≤ n) (A : Type v) [CommRing A]

/-- The coordinate Hopf algebra of the subgroup generated by the numbered root subgroups and the
weight torus of the type-`Dₙ` spin carrier. -/
noncomputable def generatedCoordinateHopfAlgebra : CommHopfAlgCat A :=
  CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra A (dimension n))
    (generatedDefiningIdeal n hn A)

end TauCeti.TypeDSpinCarrier
end
