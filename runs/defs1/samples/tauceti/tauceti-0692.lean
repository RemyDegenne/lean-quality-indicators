public section

namespace TauCeti.Sporadic

@[inherit_doc Relator.mul]
local infixl:70 " ⬝ " => Relator.mul

/-- The Group Presentations Library finite presentation `GPLTable.Fi23.1` of the Fischer group
`Fi₂₃` on generators `a`, `b`, `c`, `d`, `e`, `f`, `g`, `h`, `i`, and `j`.

The source describes this as a full presentation of the abstract group and identifies its origin
as Praeger--Soicher. No structural property of the presented group is asserted here: this
definition records only the cited generators and relations. -/
def fi23Presentation : GroupPresentation where
  generatorNames := ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j"]
  source := "R. Lindenbergh, Group Presentations Library, version 1.0; presentation attributed \
    there to C. E. Praeger and L. H. Soicher, Low Rank Representations and Graphs for Sporadic \
    Groups, Cambridge University Press, 1997"
  sourceLocator := "GPLTable.Fi23.1 in \
    https://doris.tudelft.nl/~rlindenbergh/GPL/gpl.g; Praeger--Soicher, Chapter 4, \
    doi:10.1017/CBO9780511526039.005"
  generatorConvention := "Generators are indexed alphabetically, a,b,c,d,e,f,g,h,i,j as 0 through \
    9, the order of the generator set that DeCoxList builds; GPL's FpGroupViaStrings instead \
    numbers them by first occurrence, a,b,c,d,e,f,g,j,h,i. A Coxeter path declares each node to \
    be an involution, a labeled edge x-m-y declares (x*y)^m = 1, and an omitted edge declares \
    (x*y)^2 = 1. Products are read left to right."
  transcriptionNotes := "Expand the paths a3b3c3d3e3f3g3j and d3h3i to ten square relations, \
    nine labeled-edge relations, and thirty-six omitted-edge relations. Append the two words in \
    presdef[3]. The expected relator count and total length are derived from this exact expansion. \
    The module documentation lists the expansion relation by relation. GAP \
    4.15.1 enumerates 31671 cosets of the subgroup generated by a through i, which the source \
    labels 2.Fi22."
  expectedGeneratorCount := 10
  expectedRelatorCount := 57
  transcribed := fi23RelatorList

end TauCeti.Sporadic
end
