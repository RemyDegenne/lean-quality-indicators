variable (N : ℕ) [NeZero N]

def pullPar : ↥(parabolicHoms ℂ (Gamma0 N) ℂ) ≃ₗ[ℂ] ↥(parabolicHoms ℂ (GammaH N ⊤) ℂ) where
  toFun φ := ⟨(φ : Additive ↥(Gamma0 N) →+ ℂ).comp (MonoidHom.toAdditive (κ N).toMonoidHom),
    fun γ hγ => φ.2 (κ N γ) hγ⟩
  invFun ψ := ⟨(ψ : Additive ↥(GammaH N ⊤) →+ ℂ).comp (MonoidHom.toAdditive (κ N).symm.toMonoidHom),
    fun γ hγ => ψ.2 ((κ N).symm γ) hγ⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl
  left_inv φ := Subtype.ext (by ext x; simp)
  right_inv ψ := Subtype.ext (by ext x; simp)

end EscompRank
