@[expose] public section

namespace MonoidWithZeroHom

open Set Subgroup Submonoid

variable {A B : Type*}

noncomputable section Restrict

variable [MonoidWithZero A] [GroupWithZero B] {f : A →*₀ B}

/-- The inclusion of the subgroup with zero generated by the range of a monoid with zero
hom `f : A →*₀ B` into the codomain `B`. -/
@[simps! -isSimp]
def ValueGroup₀.embedding : ValueGroup₀ f →*₀ B :=
  letI : DecidablePred fun b : B ↦ b = 0 := Classical.decPred fun b ↦ b = 0
  comp (WithZero.withZeroUnitsEquiv (G := B)) <| WithZero.map' (valueGroup f).subtype

end Restrict
end MonoidWithZeroHom
end
