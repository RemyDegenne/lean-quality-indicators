theorem even_abs_sub {n k : ℤ} (h : Even (n - k)) : Even (|n| - k) := by
  rcases abs_choice n with habs | habs <;> rw [habs]
  · exact h
  · have : -n - k = -(n - k) - 2 * k := by ring
    rw [this]
    exact h.neg.sub (even_two_mul k)

