theorem jNGeomGen_mem_of_jGeomGen_mem (K : Type*) [Field K] (N : ℕ) [NeZero N]
    (w : Place K (modularFunctionFieldC K N)) (h : jGeomGen K N ∈ w.toValuationSubring) :
    jNGeomGen K N ∈ w.toValuationSubring := by
  obtain ⟨data⟩ := ModularCurve.nonempty_modularPolynomialData N

  set P : Polynomial (modularFunctionFieldC K N) :=
    data.Φ.map (Polynomial.eval₂RingHom (Int.castRingHom (modularFunctionFieldC K N)) (jGeomGen K N)) with hP
  have hmonic : P.Monic := data.monic.map _
  have hcoeff : ∀ i, P.coeff i ∈ w.toValuationSubring := by
    intro i
    rw [hP, Polynomial.coeff_map]
    show Polynomial.eval₂RingHom (Int.castRingHom _) (jGeomGen K N) (data.Φ.coeff i) ∈ w.toValuationSubring

    have hfac : ∀ p : Polynomial ℤ, Polynomial.eval₂RingHom (Int.castRingHom (modularFunctionFieldC K N)) (jGeomGen K N) p =
        w.toValuationSubring.subtype (Polynomial.eval₂RingHom (Int.castRingHom w.toValuationSubring) ⟨jGeomGen K N, h⟩ p) := by
      intro p
      simp only [Polynomial.coe_eval₂RingHom]
      rw [Polynomial.hom_eval₂]
      congr 1
    rw [hfac]
    exact (Polynomial.eval₂RingHom (Int.castRingHom w.toValuationSubring) ⟨jGeomGen K N, h⟩ (data.Φ.coeff i)).2
  have heval : P.eval (jNGeomGen K N) = 0 := by
    have := evalModularPair_jGeomGen_eq_zero K N data
    unfold evalModularPair at this
    rw [hP, Polynomial.eval_map]
    exact this
  exact Place.mem_of_eval_monic_eq_zero w hmonic hcoeff heval

