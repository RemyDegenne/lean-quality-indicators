# Clones of the corpus (scripts/fetch.py) and the population cache (scripts/sample.py).
repos/
data/
__pycache__/

# Only the main experiment is versioned; scratch runs stay local.
runs/*
!runs/main/
!runs/file-quality-pilot-2026-10-21/

# Logs, markers, and the bulky per-call outputs of the judge (full session transcripts and
# raw `claude -p` results); the verdicts themselves are versioned.
*.log
runs/main/ALL_DONE
runs/main/rejudge-ids.txt
*.transcript.jsonl
*.raw.json
runs/main/DUP_DONE
runs/main/DUP1000_DONE
# Results of earlier prompt versions of duplicates-mathlib, kept locally.
runs/main/duplicates-mathlib/test-v*/
# Local smoke tests, including discarded runs with blocked source access.
runs/main/unnecessary-hypotheses/pilot*/
runs/file-quality-pilot-2026-10-21/reports/*/status.json
