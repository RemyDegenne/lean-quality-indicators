[Unit]
Description=Verify and publish CFSG theorem-audit progress
After=lean-quality-cfsg-theorems.service

[Service]
Type=simple
WorkingDirectory=%h/worktrees/lean-quality-indicators
ExecStart=/run/current-system/sw/bin/python3 -u scripts/watch_cfsg_theorems.py
Environment=PATH=/home/kim/.local/bin:/run/current-system/sw/bin
Restart=on-failure
RestartSec=300
StandardOutput=append:%h/worktrees/lean-quality-indicators/runs/cfsg-pilot-2026-10-27/theorems/monitor.log
StandardError=inherit

[Install]
WantedBy=default.target
