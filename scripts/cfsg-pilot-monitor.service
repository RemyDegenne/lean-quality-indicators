[Unit]
Description=Verify and publish CFSG pilot progress
After=lean-quality-cfsg-pilot.service

[Service]
Type=simple
WorkingDirectory=%h/worktrees/lean-quality-indicators
ExecStart=/run/current-system/sw/bin/python3 -u scripts/watch_cfsg_pilot.py
Environment=PATH=/home/kim/.local/bin:/run/current-system/sw/bin
Restart=on-failure
RestartSec=300
StandardOutput=append:%h/worktrees/lean-quality-indicators/runs/cfsg-pilot-2026-10-27/monitor.log
StandardError=inherit

[Install]
WantedBy=default.target
