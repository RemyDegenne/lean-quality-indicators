[Unit]
Description=Sonnet repeated-proof-machinery pilot on AxiomMath CFSG

[Service]
Type=simple
WorkingDirectory=%h/worktrees/lean-quality-indicators
ExecStart=/run/current-system/sw/bin/python3 -u scripts/cfsg_pilot.py
Environment=PATH=/home/kim/.local/bin:/run/current-system/sw/bin
Restart=on-failure
RestartSec=120
TimeoutStopSec=1250
KillMode=control-group
StandardOutput=append:%h/worktrees/lean-quality-indicators/runs/cfsg-pilot-2026-10-27/worker.log
StandardError=inherit

[Install]
WantedBy=default.target
