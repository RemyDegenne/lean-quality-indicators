[Unit]
Description=Monitor and resume Lean quality audit workers

[Service]
Type=simple
WorkingDirectory=%h/worktrees/lean-quality-indicators
ExecStart=/run/current-system/sw/bin/python3 -u scripts/watch_audit_reports.py --interval 300
Environment=PATH=/run/current-system/sw/bin
Restart=on-failure
RestartSec=60
StandardOutput=append:%h/worktrees/lean-quality-indicators/runs/main/audit-reports-watch.log
StandardError=inherit

[Install]
WantedBy=default.target
