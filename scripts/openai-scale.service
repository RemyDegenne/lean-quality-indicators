[Unit]
Description=Sonnet OpenAI Math theorem audits to 300 targets

[Service]
Type=simple
WorkingDirectory=%h/worktrees/lean-quality-indicators
ExecCondition=/run/current-system/sw/bin/python3 scripts/sonnet_scale_control.py openai --should-run
ExecStart=/run/current-system/sw/bin/python3 -u scripts/sonnet_scale_control.py openai
Environment=PATH=/home/kim/.local/bin:/run/current-system/sw/bin
Restart=always
RestartSec=30
TimeoutStopSec=1250
KillMode=control-group
StandardOutput=append:%h/worktrees/lean-quality-indicators/runs/openai-math-2026-10-21/scale-300/theorems/worker.log
StandardError=inherit

[Install]
WantedBy=default.target
