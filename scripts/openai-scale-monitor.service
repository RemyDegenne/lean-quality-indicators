[Unit]
Description=Verify and publish expanded OpenAI Math theorem-audit progress
After=lean-quality-openai-scale.service

[Service]
Type=simple
WorkingDirectory=%h/worktrees/lean-quality-indicators
ExecStart=/run/current-system/sw/bin/python3 -u scripts/openai_scale.py --watch
Environment=PATH=/home/kim/.local/bin:/run/current-system/sw/bin
Restart=on-failure
RestartSec=300
StandardOutput=append:%h/worktrees/lean-quality-indicators/runs/openai-math-2026-10-21/scale-300/theorems/monitor.log
StandardError=inherit

[Install]
WantedBy=default.target
