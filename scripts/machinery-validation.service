[Unit]
Description=Validate repeated-proof-machinery findings with the lean-fro subscription

[Service]
Type=simple
WorkingDirectory=%h/worktrees/lean-quality-indicators
ExecStart=/run/current-system/sw/bin/python3 -u scripts/validate_repeated_machinery.py --jobs 2
Environment=PATH=/home/kim/.local/bin:/run/current-system/sw/bin
Restart=on-failure
RestartSec=120
TimeoutStopSec=1250
KillMode=control-group
StandardOutput=append:%h/worktrees/lean-quality-indicators/runs/repeated-machinery-validation-2026-10-27/worker.log
StandardError=inherit

[Install]
WantedBy=default.target
