[Unit]
Description=Refresh and publish the whitepaper PDF after Sonnet audits finish
After=lean-quality-cfsg-scale-files.service lean-quality-cfsg-scale-theorems.service lean-quality-openai-scale.service

[Service]
Type=simple
WorkingDirectory=%h/worktrees/lean-quality-indicators
ExecStart=/run/current-system/sw/bin/python3 -u scripts/watch_whitepaper.py
Environment=PATH=/home/kim/.local/bin:/run/current-system/sw/bin
Restart=on-failure
RestartSec=120
StandardOutput=append:%h/worktrees/lean-quality-indicators/runs/main/whitepaper-monitor.log
StandardError=inherit

[Install]
WantedBy=default.target
