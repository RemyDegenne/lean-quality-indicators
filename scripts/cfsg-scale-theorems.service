[Unit]
Description=Sonnet hypothesis and Mathlib-duplication audits to 300 theorems on AxiomMath CFSG

[Service]
Type=simple
WorkingDirectory=%h/worktrees/lean-quality-indicators
ExecStart=/run/current-system/sw/bin/python3 -u scripts/cfsg_scale.py theorem
Environment=PATH=/home/kim/.local/bin:/run/current-system/sw/bin
Restart=on-failure
RestartSec=120
TimeoutStopSec=1250
KillMode=control-group
StandardOutput=append:%h/worktrees/lean-quality-indicators/runs/cfsg-pilot-2026-10-27/scale-300/theorems/worker.log
StandardError=inherit

[Install]
WantedBy=default.target
