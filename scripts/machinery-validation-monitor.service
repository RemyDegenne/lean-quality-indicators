[Unit]
Description=Verify and publish repeated-machinery validation progress
After=lean-quality-machinery-validation.service

[Service]
Type=simple
WorkingDirectory=%h/worktrees/lean-quality-indicators
ExecStart=/run/current-system/sw/bin/python3 -u scripts/watch_machinery_validation.py
Environment=PATH=/home/kim/.local/bin:/run/current-system/sw/bin
Restart=on-failure
RestartSec=300
StandardOutput=append:%h/worktrees/lean-quality-indicators/runs/repeated-machinery-validation-2026-10-27/monitor.log
StandardError=inherit

[Install]
WantedBy=default.target
