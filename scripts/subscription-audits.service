[Unit]
Description=Use the lean-fro subscription window for balanced library quality audits

[Service]
Type=simple
WorkingDirectory=%h/worktrees/lean-quality-indicators
ExecStart=/run/current-system/sw/bin/python3 -u scripts/subscription_audits.py
Environment=PATH=/home/kim/.local/bin:/run/current-system/sw/bin
Restart=on-failure
RestartSec=60
TimeoutStopSec=1300
KillMode=process
StandardOutput=append:%h/worktrees/lean-quality-indicators/runs/library-quality-scale-2026-10-26/worker.log
StandardError=inherit

[Install]
WantedBy=default.target
