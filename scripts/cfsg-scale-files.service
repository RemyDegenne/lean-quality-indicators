[Unit]
Description=Sonnet repeated-proof-machinery coverage to 300 files on AxiomMath CFSG

[Service]
Type=simple
WorkingDirectory=%h/worktrees/lean-quality-indicators
ExecCondition=/run/current-system/sw/bin/python3 scripts/sonnet_scale_control.py cfsg-files --should-run
ExecStart=/run/current-system/sw/bin/python3 -u scripts/sonnet_scale_control.py cfsg-files
Environment=PATH=/home/kim/.local/bin:/run/current-system/sw/bin
Restart=always
RestartSec=30
TimeoutStopSec=1250
KillMode=control-group
StandardOutput=append:%h/worktrees/lean-quality-indicators/runs/cfsg-pilot-2026-10-27/scale-300/files/worker.log
StandardError=inherit

[Install]
WantedBy=default.target
